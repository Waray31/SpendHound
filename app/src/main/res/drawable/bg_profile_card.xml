<!-- res/drawable/bg_gradient_diagonal_glow.xml -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- White diagonal glow -->
    <gradient
        android:type="linear"
        android:angle="135"
        android:startColor="@color/whitest"
        android:centerColor="@color/white"
        android:endColor="@color/whitest"
        android:centerX="0.5"
        android:centerY="0.5" />

    <!-- Rounded corners -->
    <corners android:radius="24dp" />

    <!-- Outline -->
    <stroke
        android:width="1dp"
        android:color="#22000000" />

</shape>