<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base glass -->
    <item>
        <shape>
            <gradient
                android:startColor="@color/color_card_start"
                android:endColor="@color/color_card_end"
                android:angle="135"/>
            <corners android:radius="16dp"/>
            <stroke
                android:width="1dp"
                android:color="@color/color_card_stroke"/>
        </shape>
    </item>

    <!-- Top soft reflection -->
    <item android:top="0dp">
        <shape>
            <gradient
                android:startColor="#33FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>

</layer-list>