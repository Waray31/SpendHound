<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base glass -->
    <item>
        <shape>
            <gradient
                android:startColor="#F2FFFFFF"
                android:endColor="#E6F1F1F1"
                android:angle="135"/>
            <corners android:radius="16dp"/>
            <stroke
                android:width="1dp"
                android:color="#1A000000"/>
        </shape>
    </item>

    <!-- Mid shine (center highlight) -->
    <item>
        <shape>
            <gradient
                android:type="radial"
                android:gradientRadius="200"
                android:centerX="0.5"
                android:centerY="0.5"
                android:startColor="#66FFFFFF"
                android:endColor="#00FFFFFF"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>

    <!-- Top soft reflection -->
    <item android:top="0dp">
        <shape>
            <gradient
                android:startColor="#33FFFFFF"
                android:endColor="#00FFFFFF"
                android:angle="270"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>

</layer-list>