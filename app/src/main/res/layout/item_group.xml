<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginVertical="4dp"
    android:padding="12dp"
    android:background="@drawable/rounded_border_transparent_bg"
    android:elevation="2dp"
    android:gravity="center_vertical">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/groupName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Group Name"
            android:fontFamily="@font/montserratalternatess_bold"
            android:textColor="@color/darkBlue"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/groupMembers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Members: user1, user2"
            android:fontFamily="@font/montserratalternatess_regular"
            android:textColor="@color/grey"
            android:textSize="12sp"
            android:maxLines="2"
            android:ellipsize="end" />
    </LinearLayout>

    <Button
        android:id="@+id/editGroupBtn"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/pencil"
        android:layout_marginEnd="8dp" />

    <Button
        android:id="@+id/removeGroupBtn"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:background="@drawable/close"
        android:layout_marginStart="8dp"
        android:elevation="10dp"
        android:translationZ="10dp" />

</LinearLayout>

