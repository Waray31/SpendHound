<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <FrameLayout
        android:layout_width="52dp"
        android:layout_height="52dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/payorProfileCardView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:cardCornerRadius="26dp"
            app:cardBackgroundColor="@color/orange">

            <ImageView
                android:id="@+id/payorProfileImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile_silhouette" />

        </androidx.cardview.widget.CardView>

        <ImageView
            android:id="@+id/payorStatusBadge"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="2dp"
            android:layout_marginBottom="2dp"
            android:elevation="2dp"
            android:background="@drawable/rounded_background9"
            android:padding="2dp"
            android:src="@drawable/ic_circle_checked"
            android:visibility="gone" />

    </FrameLayout>

    <TextView
        android:id="@+id/payorNameTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/montserratalternatess_regular"
        android:maxLines="1"
        android:ellipsize="end"
        android:maxWidth="72dp"
        android:text="Name"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/payorStatusTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserratalternatess_regular"
        android:text="Unpaid"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/payorBalanceAmountTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserratalternatess_bold"
        android:text="+₱ 0"
        android:visibility="gone"
        android:textSize="11sp" />

    <LinearLayout
        android:id="@+id/editButtonsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical"
        android:visibility="gone">

        <Button
            android:id="@+id/unpaid_btn"
            android:layout_width="80dp"
            android:layout_height="30dp"
            android:backgroundTint="@color/red"
            android:layout_marginBottom="2dp"
            android:padding="0dp"
            android:text="Unpaid"
            android:textSize="10sp" />

        <Button
            android:id="@+id/paid_btn"
            android:layout_width="80dp"
            android:layout_height="30dp"
            android:backgroundTint="@color/green"
            android:layout_marginBottom="2dp"
            android:padding="0dp"
            android:text="Paid"
            android:textSize="10sp" />

        <Button
            android:id="@+id/partial_btn"
            android:layout_width="80dp"
            android:layout_height="30dp"
            android:backgroundTint="@color/yellow"
            android:padding="0dp"
            android:text="Partial"
            android:textSize="10sp" />

    </LinearLayout>

</LinearLayout>
