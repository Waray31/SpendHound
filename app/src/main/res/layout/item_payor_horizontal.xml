<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp">

    <ImageView
        android:id="@+id/payorProfileImage"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/placeholder_profile_image"
        android:scaleType="centerCrop"/>

    <TextView
        android:id="@+id/payorNameTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserratalternatess_regular"
        android:textSize="12sp"
        android:text="Name"
        android:layout_marginTop="2dp"/>

    <TextView
        android:id="@+id/payorPaymentTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserratalternatess_bold"
        android:textSize="14sp"
        android:text="0.00/0.00"
        android:textColor="@color/black"/>

    <TextView
        android:id="@+id/payorStatusTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserratalternatess_regular"
        android:textSize="12sp"
        android:text="Unpaid"/>

</LinearLayout>
