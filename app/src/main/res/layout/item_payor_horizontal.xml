<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="8dp">

    <ImageView
        android:id="@+id/payorProfileImage"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/placeholder_profile_image"
        android:scaleType="centerCrop"/>

    <TextView
        android:id="@+id/payorNameTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserratalternatess_regular"
        android:textSize="12sp"
        android:text="Name"
        android:layout_marginTop="2dp"/>

    <TextView
        android:id="@+id/payorPaymentTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserratalternatess_bold"
        android:textSize="14sp"
        android:text="0.00/0.00"
        android:textColor="@color/black"/>

    <TextView
        android:id="@+id/payorStatusTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserratalternatess_regular"
        android:textSize="12sp"
        android:text="Unpaid"/>

    <LinearLayout
        android:id="@+id/editButtonsLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="4dp"
        android:visibility="gone">

        <Button
            android:id="@+id/unpaid_btn"
            android:layout_width="80dp"
            android:layout_height="32dp"
            android:text="Unpaid"
            android:textSize="10sp"
            android:backgroundTint="@color/red"
            android:padding="0dp"
            android:layout_marginBottom="2dp"/>

        <Button
            android:id="@+id/paid_btn"
            android:layout_width="80dp"
            android:layout_height="32dp"
            android:text="Paid"
            android:textSize="10sp"
            android:backgroundTint="@color/green"
            android:padding="0dp"
            android:layout_marginBottom="2dp"/>

        <Button
            android:id="@+id/partial_btn"
            android:layout_width="80dp"
            android:layout_height="32dp"
            android:text="Partial"
            android:textSize="10sp"
            android:backgroundTint="@color/yellow"
            android:padding="0dp"/>

    </LinearLayout>

</LinearLayout>
