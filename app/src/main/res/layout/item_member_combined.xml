<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_member_row"
    android:padding="8dp">

    <!-- Member Name and Subtitle -->
    <LinearLayout
        android:id="@+id/layoutNameInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/progressBarLongPress"
        app:layout_constraintEnd_toStartOf="@id/layoutAmountInput"
        app:layout_constraintHorizontal_weight="1.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMemberName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserratalternatess_regular"
                android:text="John Doe"
                android:textColor="@color/darkBlue"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/ivWarningIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_info_24dp"
                android:visibility="gone"
                app:tint="@color/orange" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutTags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tagCovering"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_teal"
                android:fontFamily="@font/montserratalternatess_bold"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="Covering 2"
                android:textColor="#004d40"
                android:textSize="9sp"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

    </LinearLayout>

    <!-- Amount Paid Input -->
    <LinearLayout
        android:id="@+id/layoutAmountInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/progressBarLongPress"
        app:layout_constraintEnd_toStartOf="@id/layoutToggle"
        app:layout_constraintHorizontal_weight="2"
        app:layout_constraintStart_toEndOf="@id/layoutNameInfo"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutMemberAmount"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Amount Paid"
                app:boxBackgroundColor="@color/whitest"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp"
                app:boxStrokeColor="@color/darkBlue"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:hintTextColor="@color/grey"
                app:prefixText="₱">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMemberAmount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:textColor="@color/darkBlue"
                    android:textSize="12sp" />

            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:id="@+id/tvCoveredStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/montserratalternatess_regular"
                android:gravity="center"
                android:text="Covered by Jane"
                android:background="@drawable/bg_tag_amber"
                android:textColor="#856404"
                android:padding="4dp"
                android:textSize="12sp"
                android:visibility="gone"
                tools:visibility="visible" />
        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/layoutCustomSplit"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Split Share"
                app:boxBackgroundColor="@color/whitest"
                app:boxCornerRadiusBottomEnd="8dp"
                app:boxCornerRadiusBottomStart="8dp"
                app:boxCornerRadiusTopEnd="8dp"
                app:boxCornerRadiusTopStart="8dp"
                app:boxStrokeColor="@color/darkBlue"
                app:boxStrokeWidth="1dp"
                app:boxStrokeWidthFocused="1dp"
                app:hintTextColor="@color/grey"
                app:prefixText="₱"
                tools:visibility="gone">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etCustomSplit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:imeOptions="actionDone"
                    android:inputType="numberDecimal"
                    android:textColor="@color/darkBlue"
                    android:textSize="12sp" />

            </com.google.android.material.textfield.TextInputLayout>
        </FrameLayout>

    </LinearLayout>

    <!-- In/Out Toggle -->
    <LinearLayout
        android:id="@+id/layoutToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@id/progressBarLongPress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/layoutSplitToggle"
            android:layout_width="56dp"
            android:layout_height="28dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_toggle_track"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/toggleThumb"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/bg_toggle_thumb"
                android:elevation="2dp" />

            <TextView
                android:id="@+id/tvToggleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/montserratalternatess_bold"
                android:text="OUT"
                android:textColor="@color/grey"
                android:textSize="9sp" />

        </FrameLayout>
    </LinearLayout>

    <!-- Long Press Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBarLongPress"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/bg_progress_bar_horizontal"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutNameInfo"
        tools:progress="50"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>