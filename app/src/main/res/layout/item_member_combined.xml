<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_member_row"
    android:padding="8dp">

    <!-- Member Name and Subtitle -->
    <LinearLayout
        android:id="@+id/layoutNameInfo"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/progressBarLongPress"
        app:layout_constraintEnd_toStartOf="@id/layoutAmountInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMemberName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserratalternatess_regular"
                android:text="John Doe"
                android:textColor="@color/darkBlue"
                android:textSize="14sp" />

            <ImageView
                android:id="@+id/ivWarningIcon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_info_24dp"
                android:visibility="gone"
                app:tint="@color/orange" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvCoverSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserratalternatess_regular"
            android:text="Share absorbed by Jane"
            android:textColor="@color/grey"
            android:textSize="10sp"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:id="@+id/layoutTags"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tagCovered"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_amber"
                android:fontFamily="@font/montserratalternatess_bold"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="covered by Jane"
                android:textColor="#856404"
                android:textSize="9sp"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tagCovering"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_tag_teal"
                android:fontFamily="@font/montserratalternatess_bold"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:text="covering 2"
                android:textColor="#004d40"
                android:textSize="9sp"
                android:visibility="gone"
                tools:visibility="visible" />

        </LinearLayout>

    </LinearLayout>

    <!-- Amount Paid Input -->
    <LinearLayout
        android:id="@+id/layoutAmountInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/progressBarLongPress"
        app:layout_constraintEnd_toStartOf="@id/layoutToggle"
        app:layout_constraintStart_toEndOf="@id/layoutNameInfo"
        app:layout_constraintTop_toTopOf="parent">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="0.00"
            app:boxBackgroundColor="@color/whitest"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp"
            app:boxStrokeColor="@color/darkBlue"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="1dp"
            app:hintTextColor="@color/grey"
            app:prefixText="₱">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etMemberAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:textSize="12sp" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/tvSplitBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/montserratalternatess_bold"
            android:text="₱125.00"
            android:textColor="@color/green"
            android:textSize="11sp"
            android:visibility="gone"
            tools:text="₱125.00"
            tools:visibility="visible" />

    </LinearLayout>

    <!-- In/Out Toggle -->
    <LinearLayout
        android:id="@+id/layoutToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        app:layout_constraintBottom_toTopOf="@id/progressBarLongPress"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <FrameLayout
            android:id="@+id/layoutSplitToggle"
            android:layout_width="60dp"
            android:layout_height="32dp"
            android:layout_margin="4dp"
            android:background="@drawable/bg_toggle_track"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/toggleThumb"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical|start"
                android:background="@drawable/bg_toggle_thumb"
                android:elevation="2dp" />

            <TextView
                android:id="@+id/tvToggleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="5dp"
                android:fontFamily="@font/montserratalternatess_bold"
                android:text="OUT"
                android:textColor="@color/grey"
                android:textSize="10sp" />

        </FrameLayout>
    </LinearLayout>

    <!-- Long Press Progress Bar -->
    <ProgressBar
        android:id="@+id/progressBarLongPress"
        style="@style/Widget.AppCompat.ProgressBar.Horizontal"
        android:layout_width="0dp"
        android:layout_height="4dp"
        android:layout_marginTop="8dp"
        android:max="100"
        android:progress="0"
        android:progressDrawable="@drawable/bg_progress_bar_horizontal"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutNameInfo"
        tools:progress="50"
        tools:visibility="visible" />

</androidx.constraintlayout.widget.ConstraintLayout>