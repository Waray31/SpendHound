<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_member_row"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Member Name -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvMemberName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/montserratalternatess_regular"
            android:text="John Doe"
            android:textColor="@color/darkBlue"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/ivWarningIcon"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="4dp"
            android:src="@drawable/ic_info_24dp"
            android:visibility="gone"
            app:tint="@color/orange" />

    </LinearLayout>

    <!-- Amount Paid Input -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:layout_weight="2"
        android:hint="0.00"
        app:boxBackgroundColor="@color/whitest"
        app:boxCornerRadiusBottomEnd="8dp"
        app:boxCornerRadiusBottomStart="8dp"
        app:boxCornerRadiusTopEnd="8dp"
        app:boxCornerRadiusTopStart="8dp"
        app:boxStrokeColor="@color/darkBlue"
        app:boxStrokeWidth="1dp"
        app:boxStrokeWidthFocused="1dp"
        app:hintTextColor="@color/grey"
        app:prefixText="₱">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMemberAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@null"
            android:inputType="numberDecimal"
            android:imeOptions="actionDone"
            android:textSize="12sp" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- In/Out Toggle -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center">

        <FrameLayout
            android:id="@+id/layoutSplitToggle"
            android:layout_width="60dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_toggle_track"
            android:clickable="true"
            android:focusable="true">

            <View
                android:id="@+id/toggleThumb"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center_vertical|start"
                android:background="@drawable/bg_toggle_thumb"
                android:elevation="2dp" />

            <TextView
                android:id="@+id/tvToggleLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="5dp"
                android:fontFamily="@font/montserratalternatess_bold"
                android:text="OUT"
                android:textColor="@color/grey"
                android:textSize="10sp" />

        </FrameLayout>
    </LinearLayout>

</LinearLayout>