<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingVertical="10dp"
    android:gravity="center_vertical">

    <androidx.cardview.widget.CardView
        android:id="@+id/memberAvatarCardView"
        android:layout_width="40dp"
        android:layout_height="40dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:cardBackgroundColor="@color/orange">

        <ImageView
            android:id="@+id/ivMemberAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_profile_silhouette"
            app:tint="@color/white" />

    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_weight="1"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvMemberName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserratalternatess_bold"
            android:textColor="@color/black"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvAdminBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin"
            android:fontFamily="@font/montserratalternatess_bold"
            android:textColor="@color/primary_accent"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/btnRemoveMember"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/circular_button_background"
        android:backgroundTint="#33FFFFFF"
        android:src="@android:drawable/ic_delete"
        android:contentDescription="Remove"
        android:visibility="gone"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        app:tint="@color/red" />

</LinearLayout>
