<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Payment &amp; Split Details"
            android:fontFamily="@font/montserratalternatess_bold"
            android:textColor="@color/darkBlue"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close_24dp"
            app:tint="@color/grey" />

    </LinearLayout>

    <!-- Item Info -->
    <LinearLayout
        android:id="@+id/layoutItemInfo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_add_expense_btn"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@id/layoutHeader">

        <TextView
            android:id="@+id/tvItemTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Item 1"
            android:fontFamily="@font/montserratalternatess_bold"
            android:textColor="@color/darkBlue"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tvItemAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱500.00"
                android:fontFamily="@font/montserratalternatess_bold"
                android:textColor="@color/darkBlue"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvIndividualShare"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱250.00 each"
                android:fontFamily="@font/montserratalternatess_regular"
                android:textColor="@color/grey"
                android:textSize="12sp"
                tools:text="₱250.00 each" />
        </LinearLayout>

    </LinearLayout>

    <!-- Members Section -->
    <LinearLayout
        android:id="@+id/layoutMembersHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/layoutItemInfo">

        <TextView
            android:id="@+id/tvPerMemberLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:fontFamily="@font/montserratalternatess_bold"
            android:text="Per Member"
            android:textColor="@color/darkBlue"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/layoutToggleContainer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_light_toggle_container"
            android:orientation="horizontal"
            android:padding="2dp">

            <TextView
                android:id="@+id/btnModeEqually"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/toggle_selected_background"
                android:textAlignment="center"
                android:fontFamily="@font/montserratalternatess_bold"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Equally"
                android:textColor="@color/whitest"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/btnModeExact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="@font/montserratalternatess_bold"
                android:textAlignment="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Exact"
                android:textColor="@color/grey"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Column Headers -->
    <LinearLayout
        android:id="@+id/layoutColumnHeaders"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toBottomOf="@id/layoutMembersHeader">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:text="Name"
            android:fontFamily="@font/montserratalternatess_bold"
            android:textColor="@color/grey"
            android:textSize="12sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:layout_marginHorizontal="8dp"
            android:text="Amount Paid"
            android:fontFamily="@font/montserratalternatess_bold"
            android:textColor="@color/grey"
            android:textSize="12sp"
            android:gravity="center" />

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="Split"
            android:fontFamily="@font/montserratalternatess_bold"
            android:textColor="@color/grey"
            android:textSize="12sp"
            android:gravity="center" />

    </LinearLayout>

    <!-- Members List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMembers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@id/layoutRemaining"
        app:layout_constraintTop_toBottomOf="@id/layoutColumnHeaders"
        app:layout_constraintVertical_bias="0.0" />

    <!-- Remaining Amount -->
    <LinearLayout
        android:id="@+id/layoutRemaining"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintBottom_toTopOf="@id/btnConfirm"
        app:layout_constraintTop_toBottomOf="@id/rvMembers">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Remaining:"
            android:fontFamily="@font/montserratalternatess_regular"
            android:textColor="@color/darkBlue"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/tvRemainingAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₱0.00"
            android:fontFamily="@font/montserratalternatess_bold"
            android:textColor="@color/green"
            android:textSize="14sp"
            tools:text="₱0.00" />

    </LinearLayout>

    <!-- Confirm Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConfirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/rounded_button"
        android:enabled="false"
        android:fontFamily="@font/montserratalternatess_bold"
        android:paddingVertical="12dp"
        android:text="Confirm"
        android:textAllCaps="false"
        android:textColor="@color/whitest"
        android:textSize="14sp"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutRemaining" />

</androidx.constraintlayout.widget.ConstraintLayout>
