<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="20dp"
    android:layout_marginTop="20dp"
    android:background="@color/whitest"
    android:orientation="vertical">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserratalternatess_bold"
            android:text="@string/transactionList"
            android:textAlignment="center"
            android:textColor="@color/darkBlue"
            android:textSize="22sp" />

    </LinearLayout>

    <View
        android:id="@+id/bottom_border1"
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bottom_border" />

    <!-- Filter Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingVertical="8dp">

        <Spinner
            android:id="@+id/groupSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/transparent_background" />

        <Button
            android:id="@+id/datePickerButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/transparent_background"
            android:textAllCaps="false"
            android:textColor="@color/darkBlue"
            android:textSize="14sp"
            android:textAlignment="center" />

    </LinearLayout>

    <!-- Status Tabs -->
    <LinearLayout
        android:id="@+id/statusTabs_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp">

        <TextView
            android:id="@+id/allTabTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAlignment="center"
            android:textColor="@color/darkBlue"
            android:fontFamily="@font/montserratalternatess_bold"
            android:text="@string/tab_all"
            android:textSize="14sp"
            android:paddingVertical="8dp"
            android:background="@drawable/bg_status_tab_selected"
            android:clickable="true" />
        <TextView
            android:id="@+id/paidTabTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAlignment="center"
            android:textColor="@color/darkBlue"
            android:fontFamily="@font/montserratalternatess_bold"
            android:text="@string/tab_paid"
            android:textSize="14sp"
            android:paddingVertical="8dp"
            android:clickable="true"/>
        <TextView
            android:id="@+id/unpaidTabTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAlignment="center"
            android:textColor="@color/darkBlue"
            android:fontFamily="@font/montserratalternatess_bold"
            android:text="@string/tab_unpaid"
            android:textSize="14sp"
            android:paddingVertical="8dp"
            android:clickable="true" />
        <TextView
            android:id="@+id/pendingTabTV"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAlignment="center"
            android:textColor="@color/darkBlue"
            android:fontFamily="@font/montserratalternatess_bold"
            android:text="@string/tab_pending"
            android:textSize="14sp"
            android:paddingVertical="8dp"
            android:clickable="true" />
    </LinearLayout>

    <View
        android:id="@+id/bottom_border_tabs"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@drawable/border_line_darkblue" />

    <!-- Scrollable Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="20dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Current Month Display -->
            <TextView
                android:id="@+id/currentMonthTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserratalternatess_bold"
                android:paddingTop="16dp"
                android:paddingBottom="8dp"
                android:text="February 2026"
                android:textColor="@color/darkBlue"
                android:textSize="18sp" />

            <!-- Transaction Count -->
            <TextView
                android:id="@+id/transactionCountTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserratalternatess_regular"
                android:paddingBottom="8dp"
                android:text="0 transactions"
                android:textColor="@color/grey"
                android:textSize="12sp" />

            <!-- Loading Progress -->
            <ProgressBar
                style="@style/CustomProgressBarStyle"
                android:id="@+id/loadingProgressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/emptyStateLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="48dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:alpha="0.5"
                    android:contentDescription="No transactions"
                    android:src="@drawable/others" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/montserratalternatess_regular"
                    android:text="No transactions found"
                    android:textColor="@color/grey"
                    android:textSize="16sp" />

            </LinearLayout>

            <!-- Transaction List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/allTransactionsRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/fragment_transaction" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>