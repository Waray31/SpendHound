<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/whitest"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Reactions"
            android:fontFamily="@font/montserratalternatess_bold"
            android:textColor="@color/black"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/btnDetailClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_profile_card"
            android:src="@drawable/ic_close_24dp"
            app:tint="@color/black"
            android:contentDescription="Close" />

    </LinearLayout>

    <!-- Reactions List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvReactionDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="400dp"
        android:layout_marginBottom="32dp" />

    <!-- Tabs/Filters at bottom -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/layoutReactionFilters"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALL"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/montserratalternatess_bold"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:background="@drawable/bg_profile_card" />

            <TextView
                android:id="@+id/tabLike"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/montserratalternatess_bold"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tabLove"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/montserratalternatess_bold"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tabHaha"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/montserratalternatess_bold"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tabWow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/montserratalternatess_bold"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tabSad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/montserratalternatess_bold"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tabFire"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/montserratalternatess_bold"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:visibility="gone" />

        </LinearLayout>
    </HorizontalScrollView>

</LinearLayout>