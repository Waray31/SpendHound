<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="20dp"
    android:layout_margin="20dp"
    android:background="@drawable/bg_profile_card"
    android:backgroundTint="@color/whitest">

    <!-- Title -->
    <TextView
        android:id="@+id/dialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserratalternatess_bold"
        android:text="@string/dialog_confirm_settlement_title"
        android:textAlignment="center"
        android:textColor="@color/darkBlue"
        android:textSize="18sp" />

    <!-- Message -->
    <TextView
        android:id="@+id/dialogMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:fontFamily="@font/montserratalternatess_regular"
        android:text="Are you sure you want to settle the selected transactions?"
        android:textAlignment="center"
        android:textColor="@color/grey"
        android:textSize="14sp" />

    <!-- Summary Details (Optional - can be populated dynamically) -->
    <LinearLayout
        android:id="@+id/settlementSummaryLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvSummaryAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserratalternatess_bold"
            android:textColor="@color/green"
            android:textSize="20sp"
            android:text="₱ 0.00" />

        <TextView
            android:id="@+id/tvSummaryCount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserratalternatess_regular"
            android:textColor="@color/grey"
            android:textSize="12sp"
            android:text="0 transactions" />
    </LinearLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        android:gravity="center">

        <Button
            android:id="@+id/dialogCancelBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/round_border_glassy"
            android:fontFamily="@font/montserratalternatess_bold"
            android:text="@string/btn_cancel"
            android:textColor="@color/darkBlue"
            android:textSize="12sp" />

        <Button
            android:id="@+id/dialogConfirmBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.5"
            android:layout_margin="4dp"
            android:background="@drawable/rounded_button"
            android:fontFamily="@font/montserratalternatess_bold"
            android:text="@string/btn_settle_now"
            android:textColor="@color/whitest"
            android:textSize="12sp"
            app:backgroundTint="@null"/>

    </LinearLayout>

</LinearLayout>
