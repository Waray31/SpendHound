<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="20dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Calculate Member Shares"
            android:fontFamily="@font/montserratalternatess_bold"
            android:textColor="@color/darkBlue"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close_24dp"
            app:tint="@color/grey" />

    </LinearLayout>

    <!-- Member Selection -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Select Member"
        android:fontFamily="@font/montserratalternatess_bold"
        android:textColor="@color/darkBlue"
        android:textSize="14sp"
        android:layout_marginBottom="12dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMembers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        tools:listitem="@layout/item_member_selection"
        android:layout_marginBottom="20dp" />

    <!-- Breakdown Section -->
    <LinearLayout
        android:id="@+id/breakdownContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Selected Member Header -->
        <TextView
            android:id="@+id/tvSelectedMemberName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Member Name"
            android:fontFamily="@font/montserratalternatess_bold"
            android:textColor="@color/darkBlue"
            android:textSize="16sp"
            android:layout_marginBottom="16dp"
            android:gravity="center" />

        <!-- Receivables (Owed to this member) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Receivables (You're Owed)"
            android:fontFamily="@font/montserratalternatess_bold"
            android:textColor="@color/green"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvReceivables"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            tools:listitem="@layout/item_share_breakdown" />

        <TextView
            android:id="@+id/tvEmptyReceivables"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No receivable data"
            android:fontFamily="@font/montserratalternatess_regular"
            android:textColor="@color/grey"
            android:textSize="13sp"
            android:paddingVertical="12dp"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- Debts (You Owe) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Debts (You Owe)"
            android:fontFamily="@font/montserratalternatess_bold"
            android:textColor="#F44336"
            android:textSize="13sp"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDebts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            tools:listitem="@layout/item_share_breakdown" />

        <TextView
            android:id="@+id/tvEmptyDebts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No debt data"
            android:fontFamily="@font/montserratalternatess_regular"
            android:textColor="@color/grey"
            android:textSize="13sp"
            android:paddingVertical="12dp"
            android:gravity="center"
            android:visibility="gone"
            android:layout_marginBottom="16dp" />

        <!-- Summary -->
        <LinearLayout
            android:id="@+id/summaryContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_add_expense_btn"
            android:padding="12dp"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tvSummary"
                android:textAlignment="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserratalternatess_bold"
                android:textColor="@color/darkBlue"
                android:textSize="14sp"/>

        </LinearLayout>

        <!-- Total Net -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_item_info"
            android:padding="12dp"
            android:layout_marginTop="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Net Total:"
                android:fontFamily="@font/montserratalternatess_bold"
                android:textColor="@color/darkBlue"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvNetTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₱0.00"
                android:fontFamily="@font/montserratalternatess_bold"
                android:textColor="@color/darkBlue"
                android:textSize="16sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
