<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="12dp"
        android:background="@drawable/bottom_round_border"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/dialogCloseBtn"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/circular_button_background"
                android:backgroundTint="@color/glassy_background"
                android:src="@drawable/ic_back"
                android:contentDescription="Back"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvActivityTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Borrow money"
                    android:fontFamily="@font/montserratalternatess_bold"
                    android:textColor="@color/whitest"
                    android:textSize="20sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="20dp">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Borrower Section -->
                    <TextView
                        android:id="@+id/tvBorrowerLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserratalternatess_bold"
                        android:text="Borrower"
                        android:textColor="@color/grey"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/dialogBorrower"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_light_input"
                        android:backgroundTint="@color/white2"
                        android:fontFamily="@font/montserratalternatess_bold"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:text="Mona"
                        android:textColor="@color/color_input_text" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvBorrowers"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_payor_chip_dark" />

                    <!-- Borrow From Section -->
                    <TextView
                        android:id="@+id/tvBorrowFromLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/montserratalternatess_bold"
                        android:text="Borrow from"
                        android:textColor="@color/grey"
                        android:textSize="12sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvLenders"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:clipToPadding="false"
                        android:orientation="horizontal"
                        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                        tools:listitem="@layout/item_payor_chip_dark" />

                    <TextView
                        android:id="@+id/dialogLender"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_light_input"
                        android:fontFamily="@font/montserratalternatess_bold"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/black"
                        android:visibility="gone" />

                    <!-- Amount Section -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/montserratalternatess_bold"
                        android:text="Amount"
                        android:textColor="@color/grey"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/dialogBorrowEditText"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_light_input"
                        android:backgroundTint="@color/white2"
                        android:fontFamily="@font/montserratalternatess_bold"
                        android:hint="₱ 500"
                        android:inputType="numberDecimal"
                        android:paddingHorizontal="16dp"
                        android:textColor="@color/color_input_text"
                        android:textColorHint="@color/grey" />

                    <!-- Date Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserratalternatess_bold"
                                android:text="Date borrowed"
                                android:textColor="@color/grey"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/dialogBorrowDate"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_light_input"
                                android:backgroundTint="@color/white2"
                                android:fontFamily="@font/montserratalternatess_bold"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="16dp"
                                android:text="Apr 18"
                                android:textColor="@color/color_input_text" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserratalternatess_bold"
                                android:text="Pay back by"
                                android:textColor="@color/grey"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/dialogPaybackDate"
                                android:layout_width="match_parent"
                                android:layout_height="52dp"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_light_input"
                                android:backgroundTint="@color/white2"
                                android:fontFamily="@font/montserratalternatess_bold"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="16dp"
                                android:text="Set date"
                                android:textColor="@color/grey" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Note Section -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/montserratalternatess_bold"
                        android:text="Note / reason"
                        android:textColor="@color/grey"
                        android:textSize="12sp" />

                    <EditText
                        android:id="@+id/dialogNoteEditText"
                        android:layout_width="match_parent"
                        android:layout_height="80dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_light_input"
                        android:backgroundTint="@color/white2"
                        android:fontFamily="@font/montserratalternatess_bold"
                        android:gravity="top"
                        android:hint="e.g. for groceries, emergency, etc."
                        android:padding="12dp"
                        android:textColor="@color/color_input_text"
                        android:textColorHint="@color/grey"
                        android:textSize="14sp" />

                    <!-- Status Selection -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:fontFamily="@font/montserratalternatess_bold"
                        android:text="Status"
                        android:textColor="@color/grey"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_light_toggle_container"
                        android:padding="4dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@drawable/bg_toggle_selected_orange"
                            android:fontFamily="@font/montserratalternatess_bold"
                            android:gravity="center"
                            android:text="Unpaid"
                            android:textColor="@color/whitest"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1.2"
                            android:fontFamily="@font/montserratalternatess_bold"
                            android:gravity="center"
                            android:text="Partially paid"
                            android:textColor="@color/grey"
                            android:textSize="12sp" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:fontFamily="@font/montserratalternatess_bold"
                            android:gravity="center"
                            android:text="Paid"
                            android:textColor="@color/grey"
                            android:textSize="12sp" />
                    </LinearLayout>

                </LinearLayout>

            </ScrollView>

            <!-- Buttons Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dialogCancelBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_weight="1"
                    android:background="@drawable/round_border_glassy"
                    android:fontFamily="@font/montserratalternatess_bold"
                    android:text="Cancel"
                    android:textAllCaps="false"
                    android:textColor="@color/darkBlue"
                    app:backgroundTint="@null" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/dialogBorrowBtn"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1.5"
                    android:background="@drawable/rounded_button"
                    android:fontFamily="@font/montserratalternatess_bold"
                    android:text="Confirm borrow"
                    android:textAllCaps="false"
                    android:textColor="@color/whitest"
                    app:backgroundTint="@null" />
            </LinearLayout>
        </LinearLayout>

        <!-- Loading Overlay -->
        <LinearLayout
            android:id="@+id/loadingOverlay_borrowNow"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/glassy_background"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                style="@style/CustomProgressBarStyle"
                android:layout_width="48dp"
                android:layout_height="48dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/montserratalternatess_regular"
                android:text="@string/loading_text"
                android:textColor="@color/darkBlue"
                android:textSize="12sp" />

        </LinearLayout>
    </FrameLayout>

</LinearLayout>
