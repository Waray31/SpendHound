<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="@color/white"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="20dp"
    android:paddingBottom="92dp"
    tools:context=".ui.profile.ProfileFragment">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="4dp">


                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserratalternatess_bold"
                    android:text="@string/profile_title"
                    android:textAlignment="center"
                    android:textColor="@color/darkBlue"
                    android:textSize="20sp" />

                <ImageButton
                    android:id="@+id/settings_btn"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:alpha="0.9"
                    android:background="@drawable/transparent_background"
                    android:contentDescription="@string/settings_icon_description"
                    android:padding="4dp"
                    android:src="@drawable/ic_hexagon_double" />

            </LinearLayout>

            <View
                android:id="@+id/bottom_border1"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp"
                android:background="@drawable/bottom_border" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="8dp">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_margin="4dp">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardView_profile"
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:elevation="4dp"
                        android:foreground="@drawable/round_border_profile"
                        android:shape="ring"
                        android:thicknessRatio="1.9"
                        app:cardCornerRadius="15dp">

                        <ImageView
                            android:id="@+id/profileImageView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@string/profile_image_description"
                            android:scaleType="centerCrop"
                            android:src="@drawable/placeholder_profile_image" />
                    </androidx.cardview.widget.CardView>

                </FrameLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="8dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="4dp"
                        android:fontFamily="@font/montserratalternatess_regular"
                        android:text="@string/nickname_label"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/nicknameTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/montserratalternatess_bold"
                            android:padding="4dp"
                            android:text="@string/nickname_placeholder"
                            android:textColor="@color/darkBlue"
                            android:textSize="28sp" />

                    </LinearLayout>

                    <View
                        android:id="@+id/bottom_border"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="4dp"
                        android:background="@drawable/border_line_darkblue" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:padding="8dp"
                        android:background="@drawable/glassy_background"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/editProfile_TV"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="12sp"
                            android:paddingHorizontal="12dp "
                            android:textColor="@color/darkBlue"
                            android:fontFamily="@font/montserratalternatess_bold"
                            android:text="Edit Profile" />

                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardView_profile2"
                android:layout_width="wrap_content"
                android:layout_height="220dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/glassy_background2"
                android:elevation="4dp"
                android:innerRadius="0dp"
                android:shape="ring"
                android:thicknessRatio="1.9"
                app:cardCornerRadius="20dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/background_card2"
                    android:contentDescription="@string/card_background_description"
                    android:orientation="vertical" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="20dp"
                    android:layout_marginVertical="32dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/totalTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserratalternatess_regular"
                        android:text="@string/total_balance_label"
                        android:textColor="@color/white"
                        android:textSize="14sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/totalBalancedTextView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="4"
                            android:fontFamily="@font/montserratalternatess_regular"
                            android:text="@string/total_balance_placeholder"
                            android:textColor="@color/whitest"
                            android:textSize="36sp" />

                        <ImageView
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_marginEnd="20dp"
                            android:layout_weight="1"
                            android:background="@drawable/glassy_background2"
                            android:contentDescription="@string/chip_icon_description"
                            android:elevation="4dp"
                            android:src="@drawable/chip" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical">

                        <Button
                            android:id="@+id/breakdown_btn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:backgroundTint="@color/yellow"
                            android:elevation="3dp"
                            android:fontFamily="@font/montserratalternatess_regular"
                            android:paddingHorizontal="12dp"
                            android:text="Breakdown"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:id="@+id/balanceUnpaidLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"

                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/balanceTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/transparent_background"
                                android:fontFamily="@font/montserratalternatess_regular"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="8dp"
                                android:text="@string/balance_label"
                                android:textAlignment="center"
                                android:textColor="@color/whitest"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/unpaidTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/transparent_background"
                                android:fontFamily="@font/montserratalternatess_regular"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="8dp"
                                android:text="@string/unpaid_label"
                                android:textAlignment="center"
                                android:textColor="@color/whitest"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/oweDebtLayout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="bottom"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/oweTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/transparent_background"
                                android:fontFamily="@font/montserratalternatess_regular"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="8dp"
                                android:text="@string/owe_label"
                                android:textAlignment="center"
                                android:textColor="@color/whitest"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/debtTextView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/transparent_background"
                                android:fontFamily="@font/montserratalternatess_regular"
                                android:paddingHorizontal="12dp"
                                android:paddingVertical="8dp"
                                android:text="@string/debt_label"
                                android:textAlignment="center"
                                android:textColor="@color/whitest"
                                android:textSize="12sp" />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserratalternatess_bold"
                    android:text="@string/recent_notifications_label"
                    android:textColor="@color/grey"
                    android:textSize="16sp" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/profileLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:elevation="2dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="@font/montserratalternatess_bold"
                android:background="@drawable/rounded_button_red"
                android:text="@string/logout_button_text"
                android:textColor="@color/whitest"
                app:backgroundTint="@null"/>

        </LinearLayout>

        <!-- Loading Overlay -->
        <LinearLayout
            android:id="@+id/loadingOverlay_profile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/glassy_background"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                style="@style/CustomProgressBarStyle"
                android:layout_width="48dp"
                android:layout_height="48dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/montserratalternatess_regular"
                android:text="@string/loading_text"
                android:textColor="@color/darkBlue"
                android:textSize="12sp" />

        </LinearLayout>
    </FrameLayout>
</LinearLayout>