<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@drawable/transparent_background">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:src="@drawable/coin"
            android:contentDescription="Borrow icon"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:text="@string/dialog_borrow_now_title"
            android:fontFamily="@font/montserratalternatess_bold"
            android:textColor="@color/darkBlue"
            android:textSize="18sp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/lightgrey"/>

    <!-- Date and Borrower Info -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserratalternatess_regular"
            android:text="@string/label_date"
            android:layout_gravity="center|end"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/dialogBorrowDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserratalternatess_regular"
            android:text="@string/placeholder_date"
            android:layout_gravity="center|end"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserratalternatess_regular"
            android:text="@string/label_borrower"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/dialogBorrower"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserratalternatess_regular"
            android:text="@string/placeholder_name"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Lender Selection -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserratalternatess_regular"
        android:text="@string/dialog_borrow_from_label"
        android:textColor="@color/darkBlue"
        android:layout_marginTop="8dp"/>

    <Spinner
        android:id="@+id/dialogBorroweeSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="8dp"
        android:layout_gravity="center"
        android:background="@drawable/glassy_background"/>

    <!-- Amount Input -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserratalternatess_regular"
        android:text="@string/dialog_how_much_label"
        android:textColor="@color/darkBlue"
        android:layout_marginTop="16dp"/>

    <EditText
        android:id="@+id/dialogBorrowEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:background="@drawable/glassy_background"
        android:elevation="3dp"
        android:fontFamily="@font/montserratalternatess_regular"
        android:hint="@string/dialog_enter_amount_hint"
        android:inputType="number"
        android:paddingVertical="12dp"
        android:textAlignment="center"
        android:textSize="16sp"/>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="24dp">

        <Button
            android:id="@+id/dialogCancelBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/grey"
            android:fontFamily="@font/montserratalternatess_bold"
            android:paddingVertical="14dp"
            android:text="@string/btn_cancel"
            android:textColor="@color/whitest"
            android:textSize="14sp"/>

        <Button
            android:id="@+id/dialogBorrowBtn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/yellow"
            android:fontFamily="@font/montserratalternatess_bold"
            android:paddingVertical="14dp"
            android:text="@string/btn_borrow"
            android:textColor="@color/whitest"
            android:textSize="14sp"/>

    </LinearLayout>

    <!-- Progress Bar -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="8dp">

        <ProgressBar
            android:id="@+id/dialogProgressBar"
            style="@style/CustomProgressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/glassy_background"
            android:padding="20dp"
            android:visibility="gone" />

    </FrameLayout>

</LinearLayout>

