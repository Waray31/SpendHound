<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    app:cardCornerRadius="24dp"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/dialogCloseBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/circular_button_background"
                android:backgroundTint="#F5F5F5"
                android:src="@drawable/ic_back"
                app:tint="@color/black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="12dp"
                android:layout_toEndOf="@id/dialogCloseBtn"
                android:fontFamily="@font/montserratalternatess_bold"
                android:text="Borrow money"
                android:textColor="@color/black"
                android:textSize="20sp" />
        </RelativeLayout>

        <!-- Borrower Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserratalternatess_bold"
            android:text="Borrower"
            android:textColor="@color/grey"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/dialogBorrower"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_light_input"
            android:fontFamily="@font/montserratalternatess_bold"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp"
            android:text="Mona"
            android:textColor="@color/black" />

        <!-- Borrow From Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/montserratalternatess_bold"
            android:text="Borrow from"
            android:textColor="@color/grey"
            android:textSize="14sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvLenders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            tools:listitem="@layout/item_payor_chip_dark" />

        <!-- Amount Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/montserratalternatess_bold"
            android:text="Amount"
            android:textColor="@color/grey"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/dialogBorrowEditText"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_light_input"
            android:fontFamily="@font/montserratalternatess_bold"
            android:hint="₱ 500"
            android:inputType="numberDecimal"
            android:paddingHorizontal="16dp"
            android:textColor="@color/black"
            android:textColorHint="@color/grey" />

        <!-- Date Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserratalternatess_bold"
                    android:text="Date borrowed"
                    android:textColor="@color/grey"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/dialogBorrowDate"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_light_input"
                    android:fontFamily="@font/montserratalternatess_bold"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:text="Apr 18"
                    android:textColor="@color/black" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserratalternatess_bold"
                    android:text="Pay back by"
                    android:textColor="@color/grey"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/dialogPaybackDate"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_light_input"
                    android:fontFamily="@font/montserratalternatess_bold"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:text="Set date"
                    android:textColor="@color/grey" />
            </LinearLayout>
        </LinearLayout>

        <!-- Note Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/montserratalternatess_bold"
            android:text="Note / reason"
            android:textColor="@color/grey"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/dialogNoteEditText"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_light_input"
            android:fontFamily="@font/montserratalternatess_bold"
            android:gravity="top"
            android:hint="e.g. for groceries, emergency, etc."
            android:padding="12dp"
            android:textColor="@color/black"
            android:textColorHint="@color/grey"
            android:textSize="14sp" />

        <!-- Status Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/montserratalternatess_bold"
            android:text="Status"
            android:textColor="@color/grey"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_light_toggle_container"
            android:padding="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_toggle_selected_orange"
                android:fontFamily="@font/montserratalternatess_bold"
                android:gravity="center"
                android:text="Unpaid"
                android:textColor="@color/whitest"
                android:textSize="12sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.2"
                android:fontFamily="@font/montserratalternatess_bold"
                android:gravity="center"
                android:text="Partially paid"
                android:textColor="@color/grey"
                android:textSize="12sp" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:fontFamily="@font/montserratalternatess_bold"
                android:gravity="center"
                android:text="Paid"
                android:textColor="@color/grey"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialogCancelBtn"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:fontFamily="@font/montserratalternatess_bold"
                android:text="Cancel"
                android:textColor="@color/black"
                app:cornerRadius="12dp"
                app:strokeColor="#E0E0E0" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dialogBorrowBtn"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1.5"
                android:backgroundTint="@color/primary_accent"
                android:fontFamily="@font/montserratalternatess_bold"
                android:text="Confirm borrow"
                android:textAllCaps="false"
                android:textColor="@color/whitest"
                app:cornerRadius="12dp"
                app:strokeColor="#E0E0E0"
                app:strokeWidth="1dp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>