<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_round_border"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingVertical="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/circular_button_background"
            android:backgroundTint="@color/glassy_background"
            android:contentDescription="Back"
            android:src="@drawable/ic_back"
            app:tint="@color/white" />

        <androidx.cardview.widget.CardView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="12dp"
            app:cardBackgroundColor="@color/orange"
            app:cardCornerRadius="18dp"
            app:cardElevation="2dp">

            <ImageView
                android:id="@+id/dmRecipientAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/profile_image_description"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder_profile_image" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/tvDmRecipientName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:fontFamily="@font/montserratalternatess_bold"
            android:textColor="@color/whitest"
            android:textSize="18sp" />
    </LinearLayout>

    <!-- Emoji reaction popup -->
    <LinearLayout
        android:id="@+id/emojiPopup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/bg_light_card_outline"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp"
        android:elevation="8dp"
        android:visibility="gone" />

    <!-- Messages list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDirectMessages"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingHorizontal="12dp"/>

    <!-- Guest blocked banner -->
    <LinearLayout
        android:id="@+id/layoutGuestBlocked"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/unpaid_bg"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:src="@drawable/ic_lock"
            app:tint="@color/red" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserratalternatess_regular"
            android:text="Direct messages are only available between registered users."
            android:textColor="@color/red"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Input row -->
    <LinearLayout
        android:id="@+id/layoutDmInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <EditText
            android:id="@+id/etDmMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/spinner_border_grey"
            android:fontFamily="@font/montserratalternatess_regular"
            android:hint="Type a message…"
            android:imeOptions="actionNone"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:paddingHorizontal="14dp"
            android:paddingVertical="8dp"
            android:textColor="@color/black"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/btnSendDm"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/rounded_button"
            android:contentDescription="Send"
            android:padding="10dp"
            android:src="@drawable/ic_send"
            app:tint="@color/whitest" />
    </LinearLayout>

</LinearLayout>
