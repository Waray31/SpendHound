<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/relativeLayout_recent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="8dp"
    android:background="@drawable/rounded_white_background"
    android:elevation="2dp"
    android:orientation="vertical">

    <!-- Expandable section -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Main row (always visible) -->
            <LinearLayout
                android:id="@+id/main_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:paddingBottom="8dp"
                android:paddingTop="8dp"
                android:orientation="horizontal">

                <!-- New Transaction Indicator -->
                <View
                    android:id="@+id/unreadIndicator"
                    android:layout_width="4dp"
                    android:layout_height="40dp"
                    android:background="@color/primary_accent"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/iconImageView"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginHorizontal="12dp"
                    android:background="@drawable/rounded_background9"
                    android:padding="6dp"
                    android:src="@drawable/lightning_bolt" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/transactionTypeTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserratalternatess_bold"
                        android:text="Transaction"
                        android:textColor="@color/black"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/dateTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserratalternatess_regular"
                            android:text="Jun 27"
                            android:textAlignment="center"
                            android:textColor="@color/grey"
                            android:textSize="11sp" />

                        <!-- Status replaces "See Details >" -->
                        <TextView
                            android:id="@+id/detailsTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:fontFamily="@font/montserratalternatess_bold"
                            android:text="Unpaid"
                            android:textSize="12sp" />

                        <!-- Archived Badge -->
                        <TextView
                            android:id="@+id/archivedBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Archived"
                            android:textSize="10sp"
                            android:textColor="@color/grey"
                            android:background="@drawable/spinner_border_grey"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="2dp"
                            android:layout_marginStart="8dp"
                            android:visibility="gone" />
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/paymentAmountTextView"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="12dp"
                        android:fontFamily="@font/montserratalternatess_bold"
                        android:text="₱1,000"
                        android:textColor="@color/darkBlue"
                        android:textSize="16sp" />

                </LinearLayout>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/expandable_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginBottom="8dp"
                    android:background="#DDDDDD" />

                <!-- Items table header -->
                <LinearLayout
                    android:id="@+id/itemsTableHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="4dp"
                    android:paddingBottom="4dp">

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="5dp"
                        android:layout_weight="2"
                        android:fontFamily="@font/montserratalternatess_bold"
                        android:text="Amount"
                        android:textColor="@color/grey"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:fontFamily="@font/montserratalternatess_bold"
                        android:text="Paid by"
                        android:textColor="@color/grey"
                        android:textSize="10sp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:fontFamily="@font/montserratalternatess_bold"
                        android:text="Description"
                        android:textColor="@color/grey"
                        android:textSize="10sp" />

                </LinearLayout>

                <!-- Items table rows container -->
                <LinearLayout
                    android:id="@+id/itemsTableContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="12dp"
                    android:orientation="vertical" />

                <View
                    android:id="@+id/dividerBelowItems"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginVertical="8dp"
                    android:background="#DDDDDD" />

                <!-- Single item description (shown only for single-item transactions) -->
                <TextView
                    android:id="@+id/tvSingleDescription"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="@font/montserratalternatess_regular"
                    android:textColor="@color/grey"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <!-- Payors header + edit buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="6dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserratalternatess_bold"
                        android:text="Payors"
                        android:textSize="12sp" />

                </LinearLayout>

                <!-- Payors horizontal list -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/payorsRecyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginVertical="8dp"
                    android:background="#DDDDDD" />

                <!-- Created By -->
                <LinearLayout
                    android:id="@+id/createdBy_LL"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="8dp">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/createdByCardView"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginEnd="8dp"
                        app:cardCornerRadius="16dp"
                        app:cardElevation="0dp"
                        app:cardBackgroundColor="@color/orange">

                        <ImageView
                            android:id="@+id/createdByImageView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/ic_profile_silhouette" />

                    </androidx.cardview.widget.CardView>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserratalternatess_regular"
                            android:text="Added by "
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/createdByTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserratalternatess_bold"
                            android:textSize="12sp" />

                    </LinearLayout>

                </LinearLayout>

                <!-- Settlement section -->
                <LinearLayout
                    android:id="@+id/settlement_LL"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical"
                    android:visibility="visible">

                    <TextView
                        android:id="@+id/editTransaction_btn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bottom_round_border"
                        android:fontFamily="@font/montserratalternatess_bold"
                        android:paddingVertical="12dp"
                        android:text="Settle"
                        android:textAlignment="center"
                        android:textColor="@color/whitest"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Loading overlay -->
        <LinearLayout
            android:id="@+id/loadingOverlay_transaction"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/glassy_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                style="@style/CustomProgressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/montserratalternatess_regular"
                android:text="Loading details..."
                android:textSize="10sp" />

        </LinearLayout>

    </FrameLayout>

</LinearLayout>
