<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/crewItemContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:padding="10dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/crewAvatarCard"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_margin="4dp"
            app:cardBackgroundColor="@color/orange"
            app:cardCornerRadius="22dp"
            app:cardElevation="2dp">

            <ImageView
                android:id="@+id/crewAvatarImage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/profile_image_description"
                android:scaleType="centerCrop"
                app:tint="@color/white"
                android:src="@drawable/ic_profile_silhouette"
                 />
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/crewUsername"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserratalternatess_bold"
                android:textColor="@color/black"
                android:textSize="15sp" />

            <!-- Shown below name for guest users -->
            <TextView
                android:id="@+id/crewGuestBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:background="@drawable/bg_profile_card"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="Guest"
                android:textColor="@color/orange"
                android:textSize="10sp"
                android:visibility="gone" />

            <!-- Last message preview for registered users -->
            <TextView
                android:id="@+id/crewStatusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/grey"
                android:textSize="12sp"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:id="@+id/crewDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="16dp"
        android:background="@color/lightgrey" />

</LinearLayout>
