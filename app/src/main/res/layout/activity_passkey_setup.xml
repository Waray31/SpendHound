<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <!-- Close button -->
    <ImageButton
        android:id="@+id/btnClose"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_margin="16dp"
        android:background="@drawable/transparent_background"
        android:contentDescription="Close"
        android:src="@drawable/ic_close_24dp"
        app:tint="@color/darkBlue" />

    <!-- Hero illustration area -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <ImageView
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_marginBottom="32dp"
            android:contentDescription="Passkey"
            android:src="@drawable/ic_lock"
            app:tint="@color/yellow" />

        <!-- Title changes based on state -->
        <TextView
            android:id="@+id/tvPasskeyTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:fontFamily="@font/montserratalternatess_bold"
            android:text="Next time, skip your password"
            android:textColor="@color/yellow"
            android:textSize="24sp" />

        <!-- Active passkey status badge -->
        <TextView
            android:id="@+id/tvPasskeyActiveBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:background="@drawable/round_border_glassy"
            android:fontFamily="@font/montserratalternatess_bold"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:text="● Active on this device"
            android:textColor="@color/yellow"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="12dp"
                android:contentDescription=""
                android:src="@drawable/ic_lock"
                app:tint="@color/grey" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/montserratalternatess_regular"
                android:text="Create a passkey and use it to log in the same way you unlock your device—with a fingerprint, face scan or screen lock."
                android:textColor="@color/grey"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="12dp"
                android:contentDescription=""
                android:src="@drawable/ic_lock"
                app:tint="@color/grey" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/montserratalternatess_regular"
                android:text="Your biometric data, like a fingerprint or face scan, is never shared with SpendHound."
                android:textColor="@color/grey"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="16dp"
            android:background="#33FFFFFF" />

        <!-- Shown when NO passkey exists -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreatePasskey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/rounded_button_selector"
            android:fontFamily="@font/montserratalternatess_bold"
            android:text="Create passkey"
            android:textColor="@color/whitest"
            android:textSize="14sp"
            android:visibility="visible"
            app:backgroundTint="@null" />

        <!-- Shown when passkey EXISTS -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnEditPasskey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/rounded_button_selector"
            android:fontFamily="@font/montserratalternatess_bold"
            android:text="Edit passkey"
            android:textColor="@color/whitest"
            android:textSize="16sp"
            android:visibility="gone"
            app:backgroundTint="@null" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRemovePasskey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:background="@drawable/rounded_button_red"
            android:fontFamily="@font/montserratalternatess_bold"
            android:text="Remove passkey"
            android:textColor="@color/whitest"
            android:textSize="14sp"
            android:visibility="gone"
            app:backgroundTint="@null" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnNotNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/round_border_glassy"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/montserratalternatess_regular"
            android:text="Not now"
            android:textAlignment="center"
            android:textColor="@color/grey"
            android:textSize="14sp"
            app:backgroundTint="@null" />

        <ProgressBar
            android:id="@+id/progressBar"
            style="@style/CustomProgressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>
