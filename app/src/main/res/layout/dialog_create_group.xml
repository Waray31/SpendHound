<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/white">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Create New Group"
        android:fontFamily="@font/montserratalternatess_bold"
        android:textColor="@color/darkBlue"
        android:textSize="18sp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Group Name:"
        android:fontFamily="@font/montserratalternatess_regular"
        android:textColor="@color/darkBlue"
        android:layout_marginBottom="4dp" />

    <EditText
        android:id="@+id/groupNameEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rounded_border_transparent_bg"
        android:fontFamily="@font/montserratalternatess_regular"
        android:hint="Enter group name"
        android:inputType="text"
        android:padding="12dp"
        android:elevation="2dp"
        android:layout_marginBottom="16dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Select Members:"
        android:fontFamily="@font/montserratalternatess_regular"
        android:textColor="@color/darkBlue"
        android:layout_marginBottom="8dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:background="@drawable/rounded_border_transparent_bg"
        android:elevation="2dp">

        <LinearLayout
            android:id="@+id/usersCheckboxContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="16dp">

        <Button
            android:id="@+id/cancelGroupBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:backgroundTint="@color/grey"
            android:textColor="@color/whitest"
            android:fontFamily="@font/montserratalternatess_regular"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/createGroupBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Group"
            android:backgroundTint="@color/yellow"
            android:textColor="@color/whitest"
            android:fontFamily="@font/montserratalternatess_regular" />
    </LinearLayout>

</LinearLayout>
