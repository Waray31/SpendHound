<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:layout_marginEnd="12dp">

    <FrameLayout
        android:layout_width="56dp"
        android:layout_height="56dp">

        <androidx.cardview.widget.CardView
            android:id="@+id/selectedAvatarCardView"
            android:layout_width="56dp"
            android:layout_height="56dp"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/orange">

            <ImageView
                android:id="@+id/ivSelectedAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile_silhouette"
                android:tint="@color/white" />

        </androidx.cardview.widget.CardView>

        <ImageView
            android:id="@+id/ivRemove"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="top|end"
            android:background="@drawable/rounded_background9"
            android:padding="3dp"
            android:src="@drawable/ic_close_24dp"
            android:visibility="gone" />

    </FrameLayout>

    <TextView
        android:id="@+id/tvSelectedName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/montserratalternatess_regular"
        android:maxWidth="64dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/darkBlue"
        android:textSize="11sp" />

</LinearLayout>
