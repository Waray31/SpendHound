<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:backgroundTint="@color/white"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".MainActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment_activity_main"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/mobile_navigation" />

    <!-- Overlay: Placed behind FABs but above content -->
    <View
        android:id="@+id/fab_menu_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:clickable="true"
        android:elevation="7dp"
        android:focusable="true"
        android:visibility="gone" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:backgroundTint="@color/whitest"
        android:elevation="6dp"
        app:itemTextAppearanceActive="@style/BottomNavTextStyle"
        app:itemTextAppearanceInactive="@style/BottomNavTextStyle"
        app:labelVisibilityMode="selected"
        app:menu="@menu/bottom_nav_menu" />

    <FrameLayout
        android:id="@+id/fab_main_layout"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        app:layout_anchor="@id/navView"
        android:elevation="9dp"
        android:outlineProvider="none"
        app:layout_anchorGravity="top|center_horizontal">

        <View
            android:layout_width="74dp"
            android:layout_height="36dp"
            android:layout_gravity="center"
            android:background="@drawable/fab_background"
            android:backgroundTint="@color/white"
            android:translationY="18dp" />
    </FrameLayout>

    <!-- Main FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        app:backgroundTint="@color/yellow"
        android:contentDescription="Add"
        android:src="@drawable/baseline_add_24"
        app:elevation="16dp"
        android:outlineProvider="none"
        app:borderWidth="4dp"
        app:strokeColor="@color/whitest"
        app:layout_anchor="@id/navView"
        app:layout_anchorGravity="top|center_horizontal"
        app:tint="@color/white" />

    <!-- Mini FAB Containers: Placed after fab_main and with higher elevation -->
    <LinearLayout
        android:id="@+id/container_borrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="20dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:layout_anchor="@id/fab_main"
        app:layout_anchorGravity="center">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_borrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:backgroundTint="@color/orange"
            android:contentDescription="@string/label_borrow_money"
            android:src="@drawable/borrow_money"
            app:fabSize="mini"
            app:tint="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/montserratalternatess_bold"
            android:text="@string/label_borrow_money"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:clickable="false"
            android:focusable="false" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/container_add_transaction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="20dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:layout_anchor="@id/fab_main"
        app:layout_anchorGravity="center">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_add_transaction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:backgroundTint="@color/orange"
            android:contentDescription="@string/label_add_transaction"
            android:src="@drawable/add_transaction"
            app:fabSize="mini"
            app:tint="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/montserratalternatess_bold"
            android:text="@string/label_add_transaction"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:clickable="false"
            android:focusable="false" />
    </LinearLayout>

    <!-- Sub-FABs for Single and Multiple Transaction -->
    <LinearLayout
        android:id="@+id/container_single_transaction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="22dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:layout_anchor="@id/fab_main"
        app:layout_anchorGravity="center">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_single_transaction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:backgroundTint="@color/red_orange"
            android:contentDescription="Single Transaction"
            android:src="@drawable/single_transaction_item"
            app:fabSize="mini"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/montserratalternatess_bold"
            android:text="Single Expense"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:clickable="false"
            android:focusable="false" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/container_multi_transaction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="22dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:layout_anchor="@id/fab_main"
        app:layout_anchorGravity="center">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_multi_transaction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:backgroundTint="@color/red_orange"
            android:contentDescription="Multiple Transaction"
            android:src="@drawable/multiple_transaction_item"
            app:fabSize="mini"
            app:tint="@color/white" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/montserratalternatess_bold"
            android:text="Multiple Expenses"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:clickable="false"
            android:focusable="false" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/container_add_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:elevation="20dp"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        app:layout_anchor="@id/fab_main"
        app:layout_anchorGravity="center">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_add_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:backgroundTint="@color/orange"
            android:contentDescription="@string/label_add_group"
            android:src="@drawable/add_group"
            app:fabSize="mini"
            app:tint="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/montserratalternatess_bold"
            android:text="@string/label_add_group"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:clickable="false"
            android:focusable="false" />
    </LinearLayout>



</androidx.coordinatorlayout.widget.CoordinatorLayout>
