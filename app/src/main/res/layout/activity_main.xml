<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false"
    tools:context=".MainActivity">

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/nav_host_fragment_activity_main"
        android:name="androidx.navigation.fragment.NavHostFragment"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:defaultNavHost="true"
        app:navGraph="@navigation/mobile_navigation" />

    <!-- Overlay: Placed behind FABs but above content -->
    <View
        android:id="@+id/fab_menu_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B3000000"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true"
        android:elevation="7dp" />

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/navView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="?android:attr/windowBackground"
        app:layout_behavior="@string/hide_bottom_view_on_scroll_behavior"
        app:menu="@menu/bottom_nav_menu"
        app:itemTextAppearanceActive="@style/BottomNavTextStyle"
        app:itemTextAppearanceInactive="@style/BottomNavTextStyle"
        app:labelVisibilityMode="selected"
        android:elevation="8dp" />

    <!-- Mini FAB Containers: Higher elevation than overlay -->
    <LinearLayout
        android:id="@+id/container_borrow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_anchor="@id/fab_main"
        app:layout_anchorGravity="center"
        android:elevation="9dp">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_borrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/coin"
            app:tint="@color/white"
            android:backgroundTint="@color/yellow"
            app:fabSize="mini"
            android:contentDescription="@string/label_borrow_money" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_borrow_money"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/montserratalternatess_bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/container_add_transaction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_anchor="@id/fab_main"
        app:layout_anchorGravity="center"
        android:elevation="9dp">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_add_transaction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/baseline_add_24"
            app:tint="@color/white"
            android:backgroundTint="@color/yellow"
            app:fabSize="mini"
            android:contentDescription="@string/label_add_transaction" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_add_transaction"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/montserratalternatess_bold" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/container_add_group"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        app:layout_anchor="@id/fab_main"
        app:layout_anchorGravity="center"
        android:elevation="9dp">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_add_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/profile"
            app:tint="@color/white"
            android:backgroundTint="@color/yellow"
            app:fabSize="mini"
            android:contentDescription="@string/label_add_group" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_add_group"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/montserratalternatess_bold" />
    </LinearLayout>

    <!-- Main FAB: Highest elevation -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/baseline_add_24"
        app:tint="@color/white"
        android:backgroundTint="@color/yellow"
        app:layout_anchor="@id/navView"
        app:layout_anchorGravity="top|center_horizontal"
        android:layout_marginBottom="28dp"
        app:elevation="10dp"
        app:layout_behavior="@string/hide_bottom_view_on_scroll_behavior"
        android:contentDescription="Add" />

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:elevation="20dp">
        <ProgressBar
            android:id="@+id/progressBar"
            style="@style/CustomProgressBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/glassy_background"
            android:padding="20dp"
            android:visibility="gone" />
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>