<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/rounded_background10">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header with Icon and Type -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <ImageView
            android:id="@+id/dialogIconImageView"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/rounded_background9"
            android:padding="10dp"
            android:src="@drawable/lightning_bolt"
            android:contentDescription="Transaction icon"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/dialogTransactionType"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Electricity"
                android:fontFamily="@font/montserratalternatess_bold"
                android:textColor="@color/darkBlue"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/dialogDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="June 27, 2026"
                android:fontFamily="@font/montserratalternatess_regular"
                android:textColor="@color/grey"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/lightgrey"/>

    <!-- Amount Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Total Amount"
            android:fontFamily="@font/montserratalternatess_regular"
            android:textColor="@color/grey"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/dialogAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₱ 1,000"
            android:fontFamily="@font/montserratalternatess_bold"
            android:textColor="@color/darkBlue"
            android:textSize="18sp" />

    </LinearLayout>

    <!-- Created By Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Created by"
            android:fontFamily="@font/montserratalternatess_regular"
            android:textColor="@color/grey"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="12dp"
            android:background="@drawable/rounded_background9">

            <androidx.cardview.widget.CardView
                android:id="@+id/cardView_profile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="4dp"
                android:shape="ring"
                android:thicknessRatio="1.9"
                app:cardCornerRadius="8dp"
                android:layout_margin="4dp">

            <ImageView
                android:id="@+id/dialogCreatorProfileImage"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/placeholder_profile_image"
                android:scaleType="fitCenter"
                android:contentDescription="Creator profile" />
            </androidx.cardview.widget.CardView>
            <TextView
                android:id="@+id/dialogCreatedByName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="Username"
                android:fontFamily="@font/montserratalternatess_bold"
                android:textColor="@color/black"
                android:textSize="14sp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Payors Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Payors"
            android:fontFamily="@font/montserratalternatess_regular"
            android:textColor="@color/grey"
            android:textSize="14sp" />

        <LinearLayout
            android:id="@+id/payorsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:padding="12dp"
            android:background="@drawable/rounded_background9" />

    </LinearLayout>

    <!-- Details Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Details"
            android:fontFamily="@font/montserratalternatess_regular"
            android:textColor="@color/grey"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/dialogDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Transaction details will appear here"
            android:fontFamily="@font/montserratalternatess_regular"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:padding="12dp"
            android:background="@drawable/rounded_background9" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="16dp"
        android:background="@color/lightgrey"/>

    <!-- Close Button -->
    <Button
        android:id="@+id/dialogCloseButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="16dp"
        android:text="Close"
        android:fontFamily="@font/montserratalternatess_bold"
        android:textColor="@color/white"
        android:background="@drawable/rounded_background8"
        android:backgroundTint="@color/darkBlue" />

</LinearLayout>

</ScrollView>




