<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshLayout_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Logo Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="8dp">

                    <ImageView
                        android:id="@+id/appImg"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:elevation="4dp"
                        android:scaleType="fitCenter"
                        app:srcCompat="@drawable/logotwo" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserratalternatess_bold"
                            android:text="SpendHound"
                            android:textColor="@color/darkBlue"
                            android:textSize="22sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserratalternatess_regular"
                            android:text="Track expenses effortlessly"
                            android:textColor="@color/yellow"
                            android:textSize="13sp" />
                    </LinearLayout>

                </LinearLayout>

                <!-- Blue Spending Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingTop="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_spending_card"
                        android:layout_margin="4dp"
                        android:elevation="4dp"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <TextView
                            android:id="@+id/textView2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserratalternatess_bold"
                            android:text="↗  THIS MONTH'S SPENDING"
                            android:textColor="@color/whitest"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/totalMonthSpends"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/montserratalternatess_bold"
                            android:text="₱ 0"
                            android:textColor="@color/whitest"
                            android:textSize="52sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/monthChangeText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:background="@drawable/glassy_background3"
                            android:fontFamily="@font/montserratalternatess_bold"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="10dp"
                            android:text="● +0% from last month"
                            android:textColor="@color/white"
                            android:textSize="12sp" />

                    </LinearLayout>
                </LinearLayout>

                <!-- You Owe / You're Owed Cards -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/white"
                    android:baselineAligned="false"
                    android:orientation="horizontal"
                    android:paddingHorizontal="20dp"
                    android:layout_marginVertical="20dp">

                    <!-- You Owe Card -->
                    <LinearLayout
                        android:id="@+id/youOweCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_circle_red"
                        android:layout_weight="1"
                        android:layout_margin="8dp"
                        android:elevation="2dp"
                        android:orientation="vertical"
                        android:padding="16dp">


                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/glassy_background3"
                            android:src="@drawable/ic_you_owe"
                            app:tint="@color/red" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:fontFamily="@font/montserratalternatess_regular"
                            android:text="You Owe"
                            android:textColor="@color/darkBlue"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/youOweAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_gravity="center_horizontal"
                            android:fontFamily="@font/montserratalternatess_bold"
                            android:text="₱ 0"
                            android:textColor="@color/red"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <!-- You're Owed Card -->
                    <LinearLayout
                        android:id="@+id/youreOwedCard"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:layout_margin="8dp"
                        android:background="@drawable/bg_circle_green"
                        android:elevation="2dp"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <ImageView
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/glassy_background3"
                            android:src="@drawable/ic_youre_owed"
                            app:tint="@color/green" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:fontFamily="@font/montserratalternatess_regular"
                            android:text="You'll receive"
                            android:textColor="@color/darkBlue"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/youreOwedAmount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="8dp"
                            android:fontFamily="@font/montserratalternatess_bold"
                            android:text="₱ 0"
                            android:textColor="@color/green"
                            android:textSize="20sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Analytics + Recent Transactions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingBottom="80dp">


                    <androidx.cardview.widget.CardView
                        android:id="@+id/cardView_profile2"
                        android:layout_width="match_parent"
                        android:layout_height="280dp"
                        android:background="@drawable/glassy_background2"
                        android:elevation="4dp"
                        android:innerRadius="0dp"
                        android:shape="ring"
                        android:thicknessRatio="1.9"
                        app:cardCornerRadius="20dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/background_card"
                            android:contentDescription="@string/card_background_description"
                            android:orientation="vertical" />

                        <!-- Analytics Section -->
                        <LinearLayout
                            android:id="@+id/analyticsContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipChildren="false"
                            android:clipToPadding="false"
                            android:orientation="vertical"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="20dp">

                            <!-- Header Row: Title + Toggle -->
                            <LinearLayout
                                android:id="@+id/topBarText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <TextView
                                    android:id="@+id/textView5"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/montserratalternatess_regular"
                                    android:text="Analytics"
                                    android:textColor="@color/white"
                                    android:textSize="18sp"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/toggle_background"
                                    android:orientation="horizontal"
                                    android:padding="3dp">

                                    <TextView
                                        android:id="@+id/btnWeekly"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:background="@drawable/toggle_selected_background"
                                        android:fontFamily="@font/montserratalternatess_regular"
                                        android:paddingHorizontal="14dp"
                                        android:paddingVertical="6dp"
                                        android:text="Weekly"
                                        android:textColor="@color/whitest"
                                        android:textSize="12sp" />

                                    <TextView
                                        android:id="@+id/btnMonthly"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:background="@android:color/transparent"
                                        android:fontFamily="@font/montserratalternatess_regular"
                                        android:paddingHorizontal="14dp"
                                        android:paddingVertical="6dp"
                                        android:text="Monthly"
                                        android:textColor="#adb5bd"
                                        android:textSize="12sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Navigation Row -->
                            <LinearLayout
                                android:id="@+id/navigationBar"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageButton
                                    android:id="@+id/btnPrevious"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="@android:color/transparent"
                                    android:contentDescription="Previous"
                                    android:scaleType="centerInside"
                                    android:src="@drawable/arrow_left_with_circle" />

                                <TextView
                                    android:id="@+id/dateRangeText"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:fontFamily="@font/montserratalternatess_regular"
                                    android:gravity="center"
                                    android:text="Feb 13 - Feb 19, 2026"
                                    android:textColor="#adb5bd"
                                    android:textSize="14sp" />

                                <ImageButton
                                    android:id="@+id/btnNext"
                                    android:layout_width="32dp"
                                    android:layout_height="32dp"
                                    android:background="@android:color/transparent"
                                    android:contentDescription="Next"
                                    android:scaleType="centerInside"
                                    android:src="@drawable/arrow_right_with_circle" />
                            </LinearLayout>

                            <!-- Weekly Chart Container -->
                            <LinearLayout
                                android:id="@+id/weeklyChartContainer"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clipChildren="false"
                                android:clipToPadding="false"
                                android:orientation="vertical"
                                android:visibility="visible">

                                <LinearLayout
                                    android:id="@+id/linearLayout4"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:baselineAligned="false"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/totalday7"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/montserratalternatess_regular"
                                        android:gravity="center"
                                        android:text="0"
                                        android:textColor="@color/grey"
                                        android:textSize="10sp" />

                                    <TextView
                                        android:id="@+id/totalday6"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/montserratalternatess_regular"
                                        android:gravity="center"
                                        android:text="0"
                                        android:textColor="@color/grey"
                                        android:textSize="10sp" />

                                    <TextView
                                        android:id="@+id/totalday5"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/montserratalternatess_regular"
                                        android:gravity="center"
                                        android:text="0"
                                        android:textColor="@color/grey"
                                        android:textSize="10sp" />

                                    <TextView
                                        android:id="@+id/totalday4"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/montserratalternatess_regular"
                                        android:gravity="center"
                                        android:text="0"
                                        android:textColor="@color/grey"
                                        android:textSize="10sp" />

                                    <TextView
                                        android:id="@+id/totalday3"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/montserratalternatess_regular"
                                        android:gravity="center"
                                        android:text="0"
                                        android:textColor="@color/grey"
                                        android:textSize="10sp" />

                                    <TextView
                                        android:id="@+id/totalday2"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/montserratalternatess_regular"
                                        android:gravity="center"
                                        android:text="0"
                                        android:textColor="@color/grey"
                                        android:textSize="10sp" />

                                    <TextView
                                        android:id="@+id/totalday1"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/montserratalternatess_regular"
                                        android:gravity="center"
                                        android:text="0"
                                        android:textColor="@color/grey"
                                        android:textSize="10sp" />
                                </LinearLayout>

                                <!-- Bar Chart Row -->
                                <LinearLayout
                                    android:id="@+id/linearLayout_bars"
                                    android:layout_width="match_parent"
                                    android:layout_height="120dp"
                                    android:layout_marginVertical="4dp"
                                    android:baselineAligned="false"
                                    android:gravity="bottom"
                                    android:orientation="horizontal"
                                    android:clipChildren="false">

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        android:gravity="bottom|center_horizontal">

                                        <View
                                            android:id="@+id/day7_bar"
                                            android:layout_width="12dp"
                                            android:layout_height="10dp"
                                            android:background="@drawable/rounded_background" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        android:gravity="bottom|center_horizontal">

                                        <View
                                            android:id="@+id/day6_bar"
                                            android:layout_width="12dp"
                                            android:layout_height="10dp"
                                            android:background="@drawable/rounded_background2" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        android:gravity="bottom|center_horizontal">

                                        <View
                                            android:id="@+id/day5_bar"
                                            android:layout_width="12dp"
                                            android:layout_height="10dp"
                                            android:background="@drawable/rounded_background3" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        android:gravity="bottom|center_horizontal">

                                        <View
                                            android:id="@+id/day4_bar"
                                            android:layout_width="12dp"
                                            android:layout_height="10dp"
                                            android:background="@drawable/rounded_background4" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        android:gravity="bottom|center_horizontal">

                                        <View
                                            android:id="@+id/day3_bar"
                                            android:layout_width="12dp"
                                            android:layout_height="10dp"
                                            android:background="@drawable/rounded_background5" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        android:gravity="bottom|center_horizontal">

                                        <View
                                            android:id="@+id/day2_bar"
                                            android:layout_width="12dp"
                                            android:layout_height="10dp"
                                            android:background="@drawable/rounded_background6" />
                                    </LinearLayout>

                                    <LinearLayout
                                        android:layout_width="0dp"
                                        android:layout_height="match_parent"
                                        android:layout_weight="1"
                                        android:gravity="bottom|center_horizontal">

                                        <View
                                            android:id="@+id/day1_bar"
                                            android:layout_width="12dp"
                                            android:layout_height="10dp"
                                            android:background="@drawable/rounded_background7" />
                                    </LinearLayout>
                                </LinearLayout>

                                <!-- Day Labels Row -->
                                <LinearLayout
                                    android:id="@+id/linearLayout2"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:baselineAligned="false"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/day7"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/montserratalternatess_regular"
                                        android:gravity="center"
                                        android:text="Sun"
                                        android:textColor="@color/white"
                                        android:textSize="11sp" />

                                    <TextView
                                        android:id="@+id/day6"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/montserratalternatess_regular"
                                        android:gravity="center"
                                        android:text="Mon"
                                        android:textColor="@color/white"
                                        android:textSize="11sp" />

                                    <TextView
                                        android:id="@+id/day5"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/montserratalternatess_regular"
                                        android:gravity="center"
                                        android:text="Tue"
                                        android:textColor="@color/white"
                                        android:textSize="11sp" />

                                    <TextView
                                        android:id="@+id/day4"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/montserratalternatess_regular"
                                        android:gravity="center"
                                        android:text="Wed"
                                        android:textColor="@color/white"
                                        android:textSize="11sp" />

                                    <TextView
                                        android:id="@+id/day3"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/montserratalternatess_regular"
                                        android:gravity="center"
                                        android:text="Thu"
                                        android:textColor="@color/white"
                                        android:textSize="11sp" />

                                    <TextView
                                        android:id="@+id/day2"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/montserratalternatess_regular"
                                        android:gravity="center"
                                        android:text="Fri"
                                        android:textColor="@color/white"
                                        android:textSize="11sp" />

                                    <TextView
                                        android:id="@+id/day1"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:fontFamily="@font/montserratalternatess_regular"
                                        android:gravity="center"
                                        android:text="Sat"
                                        android:textColor="@color/white"
                                        android:textSize="11sp" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Monthly Line Chart -->
                            <com.github.mikephil.charting.charts.LineChart
                                android:id="@+id/monthlyLineChart"
                                android:layout_width="match_parent"
                                android:layout_height="160dp"
                                android:layout_marginVertical="8dp"
                                android:visibility="gone" />

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                    <!-- Recent Transactions -->
                    <LinearLayout
                        android:id="@+id/RecentLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="40dp"
                        android:layout_marginBottom="20dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/recentTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserratalternatess_bold"
                            android:text="Recent transactions"
                            android:textColor="@color/grey"
                            android:textSize="16sp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/transactionListRecycler"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:nestedScrollingEnabled="false"
                            tools:listitem="@layout/fragment_transaction" />

                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Loading Overlay -->
        <LinearLayout
            android:id="@+id/loadingOverlay_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/glassy_background"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                style="@style/CustomProgressBarStyle"
                android:layout_width="48dp"
                android:layout_height="48dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/montserratalternatess_regular"
                android:text="@string/loading_text"
                android:textColor="@color/darkBlue"
                android:textSize="14sp" />

        </LinearLayout>
    </FrameLayout>
</LinearLayout>
