<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- White Header Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/gradient_green_card"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:layout_marginStart="0dp"
                    android:layout_marginEnd="0dp">

                    <!-- Logo Row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/appImg"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:scaleType="fitCenter"
                            app:srcCompat="@drawable/logothree" />

                    </LinearLayout>

                    <!-- This month's spending label -->
                    <TextView
                        android:id="@+id/textView2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="24dp"
                        android:fontFamily="@font/montserratalternatess_regular"
                        android:text="This month's spending"
                        android:textColor="#CCFFFFFF"
                        android:textSize="15sp" />

                    <!-- Total Amount -->
                    <TextView
                        android:id="@+id/totalMonthSpends"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:fontFamily="@font/montserratalternatess_bold"
                        android:text="₱ 0"
                        android:textColor="@color/whitest"
                        android:textSize="44sp"
                        android:textStyle="bold" />

                    <!-- You Owe / You're Owed Cards -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <!-- You Owe Card -->
                        <LinearLayout
                            android:id="@+id/youOweCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginEnd="8dp"
                            android:background="@drawable/bg_summary_card"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <FrameLayout
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_circle_red">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:fontFamily="@font/montserratalternatess_bold"
                                    android:text="↗"
                                    android:textColor="@color/red"
                                    android:textSize="20sp" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="24dp"
                                android:fontFamily="@font/montserratalternatess_regular"
                                android:text="You Owe"
                                android:textColor="@color/grey"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/youOweAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/montserratalternatess_bold"
                                android:text="₱ 0"
                                android:textColor="@color/red"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- You're Owed Card -->
                        <LinearLayout
                            android:id="@+id/youreOwedCard"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_summary_card"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <FrameLayout
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_circle_green">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:fontFamily="@font/montserratalternatess_bold"
                                    android:text="↘"
                                    android:textColor="@color/green"
                                    android:textSize="20sp" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="24dp"
                                android:fontFamily="@font/montserratalternatess_regular"
                                android:text="You're Owed"
                                android:textColor="@color/grey"
                                android:textSize="13sp" />

                            <TextView
                                android:id="@+id/youreOwedAmount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:fontFamily="@font/montserratalternatess_bold"
                                android:text="₱ 0"
                                android:textColor="@color/green"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- Analytics + Recent Transactions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="20dp"
                    android:paddingBottom="40dp">

                    <!-- Analytics Section -->
                    <LinearLayout
                        android:id="@+id/analyticsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/rounded_background8"
                        android:elevation="4dp"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <!-- Header Row: Title + Toggle -->
                        <LinearLayout
                            android:id="@+id/topBarText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/textView5"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/montserratalternatess_regular"
                                android:text="Analytics"
                                android:textColor="@color/white"
                                android:textSize="18sp"
                                android:textStyle="bold" />

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/toggle_background"
                                android:orientation="horizontal"
                                android:padding="3dp">

                                <TextView
                                    android:id="@+id/btnWeekly"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@drawable/toggle_selected_background"
                                    android:fontFamily="@font/montserratalternatess_regular"
                                    android:paddingHorizontal="14dp"
                                    android:paddingVertical="6dp"
                                    android:text="Weekly"
                                    android:textColor="@color/darkBlue"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/btnMonthly"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:background="@android:color/transparent"
                                    android:fontFamily="@font/montserratalternatess_regular"
                                    android:paddingHorizontal="14dp"
                                    android:paddingVertical="6dp"
                                    android:text="Monthly"
                                    android:textColor="#adb5bd"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Navigation Row -->
                        <LinearLayout
                            android:id="@+id/navigationBar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageButton
                                android:id="@+id/btnPrevious"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@android:color/transparent"
                                android:contentDescription="Previous"
                                android:scaleType="centerInside"
                                android:src="@drawable/arrow_left_with_circle" />

                            <TextView
                                android:id="@+id/dateRangeText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:fontFamily="@font/montserratalternatess_regular"
                                android:gravity="center"
                                android:text="Feb 13 - Feb 19, 2026"
                                android:textColor="#adb5bd"
                                android:textSize="14sp" />

                            <ImageButton
                                android:id="@+id/btnNext"
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:background="@android:color/transparent"
                                android:contentDescription="Next"
                                android:scaleType="centerInside"
                                android:src="@drawable/arrow_right_with_circle" />
                        </LinearLayout>

                        <!-- Weekly Chart Container -->
                        <LinearLayout
                            android:id="@+id/weeklyChartContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical"
                            android:visibility="visible">

                            <LinearLayout
                                android:id="@+id/linearLayout4"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <TextView android:id="@+id/totalday7" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/montserratalternatess_regular" android:gravity="center" android:text="0" android:textColor="@color/grey" android:textSize="10sp" />
                                <TextView android:id="@+id/totalday6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/montserratalternatess_regular" android:gravity="center" android:text="0" android:textColor="@color/grey" android:textSize="10sp" />
                                <TextView android:id="@+id/totalday5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/montserratalternatess_regular" android:gravity="center" android:text="0" android:textColor="@color/grey" android:textSize="10sp" />
                                <TextView android:id="@+id/totalday4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/montserratalternatess_regular" android:gravity="center" android:text="0" android:textColor="@color/grey" android:textSize="10sp" />
                                <TextView android:id="@+id/totalday3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/montserratalternatess_regular" android:gravity="center" android:text="0" android:textColor="@color/grey" android:textSize="10sp" />
                                <TextView android:id="@+id/totalday2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/montserratalternatess_regular" android:gravity="center" android:text="0" android:textColor="@color/grey" android:textSize="10sp" />
                                <TextView android:id="@+id/totalday1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/montserratalternatess_regular" android:gravity="center" android:text="0" android:textColor="@color/grey" android:textSize="10sp" />
                            </LinearLayout>

                            <!-- Bar Chart Row -->
                            <LinearLayout
                                android:id="@+id/linearLayout_bars"
                                android:layout_width="match_parent"
                                android:layout_height="120dp"
                                android:layout_marginVertical="8dp"
                                android:baselineAligned="false"
                                android:gravity="bottom"
                                android:orientation="horizontal">

                                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal">
                                    <View android:id="@+id/day7_bar" android:layout_width="12dp" android:layout_height="10dp" android:background="@drawable/rounded_background" />
                                </LinearLayout>
                                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal">
                                    <View android:id="@+id/day6_bar" android:layout_width="12dp" android:layout_height="10dp" android:background="@drawable/rounded_background2" />
                                </LinearLayout>
                                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal">
                                    <View android:id="@+id/day5_bar" android:layout_width="12dp" android:layout_height="10dp" android:background="@drawable/rounded_background3" />
                                </LinearLayout>
                                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal">
                                    <View android:id="@+id/day4_bar" android:layout_width="12dp" android:layout_height="10dp" android:background="@drawable/rounded_background4" />
                                </LinearLayout>
                                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal">
                                    <View android:id="@+id/day3_bar" android:layout_width="12dp" android:layout_height="10dp" android:background="@drawable/rounded_background5" />
                                </LinearLayout>
                                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal">
                                    <View android:id="@+id/day2_bar" android:layout_width="12dp" android:layout_height="10dp" android:background="@drawable/rounded_background6" />
                                </LinearLayout>
                                <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="bottom|center_horizontal">
                                    <View android:id="@+id/day1_bar" android:layout_width="12dp" android:layout_height="10dp" android:background="@drawable/rounded_background7" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Day Labels Row -->
                            <LinearLayout
                                android:id="@+id/linearLayout2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:baselineAligned="false"
                                android:orientation="horizontal">

                                <TextView android:id="@+id/day7" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/montserratalternatess_regular" android:gravity="center" android:text="Sun" android:textColor="@color/white" android:textSize="11sp" />
                                <TextView android:id="@+id/day6" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/montserratalternatess_regular" android:gravity="center" android:text="Mon" android:textColor="@color/white" android:textSize="11sp" />
                                <TextView android:id="@+id/day5" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/montserratalternatess_regular" android:gravity="center" android:text="Tue" android:textColor="@color/white" android:textSize="11sp" />
                                <TextView android:id="@+id/day4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/montserratalternatess_regular" android:gravity="center" android:text="Wed" android:textColor="@color/white" android:textSize="11sp" />
                                <TextView android:id="@+id/day3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/montserratalternatess_regular" android:gravity="center" android:text="Thu" android:textColor="@color/white" android:textSize="11sp" />
                                <TextView android:id="@+id/day2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/montserratalternatess_regular" android:gravity="center" android:text="Fri" android:textColor="@color/white" android:textSize="11sp" />
                                <TextView android:id="@+id/day1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:fontFamily="@font/montserratalternatess_regular" android:gravity="center" android:text="Sat" android:textColor="@color/white" android:textSize="11sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Monthly Line Chart -->
                        <com.github.mikephil.charting.charts.LineChart
                            android:id="@+id/monthlyLineChart"
                            android:layout_width="match_parent"
                            android:layout_height="160dp"
                            android:layout_marginVertical="8dp"
                            android:visibility="gone" />

                    </LinearLayout>

                    <!-- Recent Transactions -->
                    <LinearLayout
                        android:id="@+id/RecentLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginVertical="20dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/recentTextView"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserratalternatess_bold"
                            android:text="Recent transactions"
                            android:textColor="@color/grey"
                            android:textSize="16sp" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/transactionListRecycler"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:nestedScrollingEnabled="false"
                            tools:listitem="@layout/fragment_transaction" />

                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Loading Overlay -->
        <LinearLayout
            android:id="@+id/loadingOverlay_home"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/glassy_background"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                style="@style/CustomProgressBarStyle"
                android:layout_width="48dp"
                android:layout_height="48dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/montserratalternatess_regular"
                android:text="@string/loading_text"
                android:textColor="@color/darkBlue"
                android:textSize="14sp" />

        </LinearLayout>
    </FrameLayout>
</LinearLayout>
