<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/offlineBanner"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:background="@color/orange"
    android:elevation="20dp"
    android:gravity="center"
    android:orientation="horizontal"
    android:visibility="gone">

    <ImageView
        android:id="@+id/bannerIcon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginEnd="8dp"
        android:src="@drawable/ic_wifi_off"
        app:tint="@color/whitest" />

    <TextView
        android:id="@+id/bannerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserratalternatess_bold"
        android:text="You're offline — showing cached data"
        android:textColor="@color/whitest"
        android:textSize="12sp" />

</LinearLayout>
