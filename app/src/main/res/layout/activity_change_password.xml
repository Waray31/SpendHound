<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <!-- Header -->
                    <ImageButton
                        android:id="@+id/btnBack"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginBottom="24dp"
                        android:background="@drawable/transparent_background"
                        android:contentDescription="Back"
                        android:src="@drawable/ic_back"
                        app:tint="@color/darkBlue" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="@font/montserratalternatess_bold"
                        android:text="Change password"
                        android:textColor="@color/darkBlue"
                        android:textSize="24sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="32dp"
                        android:fontFamily="@font/montserratalternatess_regular"
                        android:text="Your password must be at least 6 characters and should include a combination of numbers, letters and special characters (!$@%)."
                        android:textColor="@color/grey"
                        android:textSize="14sp" />

                    <!-- Current Password -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="Current password"
                        app:boxCornerRadiusBottomEnd="24dp"
                        app:boxCornerRadiusBottomStart="24dp"
                        app:boxCornerRadiusTopEnd="24dp"
                        app:boxCornerRadiusTopStart="24dp"
                        app:boxStrokeColor="@color/yellow"
                        app:endIconDrawable="@drawable/password_eye_selector"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/yellow"
                        app:hintTextColor="@color/yellow">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etCurrentPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserratalternatess_regular"
                            android:inputType="textPassword"
                            android:textColor="@color/darkBlue"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- New Password -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:hint="New password"
                        app:boxCornerRadiusBottomEnd="24dp"
                        app:boxCornerRadiusBottomStart="24dp"
                        app:boxCornerRadiusTopEnd="24dp"
                        app:boxCornerRadiusTopStart="24dp"
                        app:boxStrokeColor="@color/yellow"
                        app:endIconDrawable="@drawable/password_eye_selector"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/yellow"
                        app:hintTextColor="@color/yellow">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNewPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserratalternatess_regular"
                            android:inputType="textPassword"
                            android:textColor="@color/darkBlue"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Re-type New Password -->
                    <com.google.android.material.textfield.TextInputLayout
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:hint="Re-type new password"
                        app:boxCornerRadiusBottomEnd="24dp"
                        app:boxCornerRadiusBottomStart="24dp"
                        app:boxCornerRadiusTopEnd="24dp"
                        app:boxCornerRadiusTopStart="24dp"
                        app:boxStrokeColor="@color/yellow"
                        app:endIconDrawable="@drawable/password_eye_selector"
                        app:endIconMode="password_toggle"
                        app:endIconTint="@color/yellow"
                        app:hintTextColor="@color/yellow">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etConfirmPassword"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/montserratalternatess_regular"
                            android:inputType="textPassword"
                            android:textColor="@color/darkBlue"
                            android:textSize="16sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:id="@+id/tvForgotPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:fontFamily="@font/montserratalternatess_bold"
                        android:text="Forgot your password?"
                        android:textColor="@color/yellow"
                        android:textSize="14sp" />

                </LinearLayout>
            </ScrollView>

            <!-- Bottom bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:elevation="8dp"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnChangePassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rounded_button_selector"
                    android:fontFamily="@font/montserratalternatess_bold"
                    android:text="Change password"
                    android:textColor="@color/whitest"
                    android:textSize="16sp"
                    app:backgroundTint="@null" />

            </LinearLayout>
        </LinearLayout>

        <!-- Loading Overlay -->
        <LinearLayout
            android:id="@+id/loadingOverlay_changePass"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/glassy_background"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ProgressBar
                style="@style/CustomProgressBarStyle"
                android:layout_width="48dp"
                android:layout_height="48dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/montserratalternatess_regular"
                android:text="@string/loading_text"
                android:textColor="@color/darkBlue"
                android:textSize="12sp" />

        </LinearLayout>
    </FrameLayout>

</LinearLayout>
