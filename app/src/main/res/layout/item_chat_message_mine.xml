<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/messageRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="1dp">

    <!-- Tap-to-show timestamp — customize font, color, size here -->
    <TextView
        android:id="@+id/tvMessageTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAlignment="center"
        android:layout_marginVertical="4dp"
        android:fontFamily="@font/montserratalternatess_regular"
        android:textColor="@color/grey"
        android:textSize="11sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bubbleRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginStart="16dp">


        <LinearLayout
            android:id="@+id/bubbleContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="260dp"
            android:orientation="vertical">

            <!-- Optional transaction card -->
            <LinearLayout
                android:id="@+id/transactionCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@drawable/bg_light_card_outline"
                android:padding="10dp"
                android:layout_marginBottom="4dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvTransactionTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserratalternatess_bold"
                        android:textColor="@color/black"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvTransactionAmount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/montserratalternatess_regular"
                        android:textColor="@color/grey"
                        android:textSize="11sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvTransactionStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:fontFamily="@font/montserratalternatess_bold"
                    android:textSize="10sp"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:background="@drawable/rounded_background" />
            </LinearLayout>

            <!-- Message bubble — customize background, padding, corners here -->
            <LinearLayout
                android:id="@+id/bubble"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_bubble_mine"
                android:stateListAnimator="@null"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp">

                <!-- Customize text color, size, font here -->
                <TextView
                    android:id="@+id/tvMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/montserratalternatess_regular"
                    android:textColor="@color/whitest"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Reactions row -->
            <LinearLayout
                android:id="@+id/reactionsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="2dp"
                android:background="@drawable/bg_profile_card"
                android:layout_gravity="end"
                android:layout_marginTop="-6dp"
                android:layout_marginEnd="4dp"
                android:visibility="gone" />

            <!-- Sent / Sending status — customize color, font here -->
            <TextView
                android:id="@+id/tvSendStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="4dp"
                android:fontFamily="@font/montserratalternatess_regular"
                android:textColor="@color/grey"
                android:textSize="10sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
