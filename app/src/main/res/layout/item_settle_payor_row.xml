<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingVertical="10dp">

    <ImageView
        android:id="@+id/settlePayorImage"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:scaleType="centerCrop"
        android:src="@drawable/placeholder_profile_image" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/settlePayorName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserratalternatess_bold"
            android:textColor="@color/darkBlue"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/settlePayorOwed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserratalternatess_regular"
            android:textColor="@color/grey"
            android:textSize="11sp" />

    </LinearLayout>

    <!-- Quick-action buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/settleUnpaidBtn"
            android:layout_width="56dp"
            android:layout_height="32dp"
            android:layout_marginEnd="4dp"
            android:backgroundTint="@color/red"
            android:fontFamily="@font/montserratalternatess_regular"
            android:padding="0dp"
            android:text="Unpaid"
            android:textSize="9sp" />

        <Button
            android:id="@+id/settlePaidBtn"
            android:layout_width="48dp"
            android:layout_height="32dp"
            android:backgroundTint="@color/green"
            android:fontFamily="@font/montserratalternatess_regular"
            android:padding="0dp"
            android:text="Paid"
            android:textSize="9sp" />

    </LinearLayout>

    <EditText
        android:id="@+id/settleAmountInput"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:background="@drawable/edittext_bg"
        android:fontFamily="@font/montserratalternatess_regular"
        android:inputType="numberDecimal"
        android:padding="6dp"
        android:textSize="13sp" />

</LinearLayout>
