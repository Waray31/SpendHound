<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/bg_add_expense_btn"
    android:paddingHorizontal="4dp"
    android:layout_marginTop="8dp"
    android:paddingVertical="10dp">

    <!-- Row 1: Avatar + Name/Owed -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:layout_marginBottom="8dp">

        <ImageView
            android:id="@+id/settlePayorImage"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:scaleType="centerCrop"
            android:src="@drawable/placeholder_profile_image" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/settlePayorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserratalternatess_bold"
                android:textColor="@color/darkBlue"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/settlePayorOwed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserratalternatess_regular"
                android:textColor="@color/grey"
                android:textSize="11sp" />

        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            app:boxBackgroundColor="@color/whitest"
            app:boxCornerRadiusBottomEnd="8dp"
            app:boxCornerRadiusBottomStart="8dp"
            app:boxCornerRadiusTopEnd="8dp"
            app:boxCornerRadiusTopStart="8dp"
            app:boxStrokeColor="@color/darkBlue"
            app:boxStrokeWidth="1dp"
            app:boxStrokeWidthFocused="1dp"
            app:hintTextColor="@color/grey"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.Dense">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/settleAmountInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@null"
                android:inputType="numberDecimal" />
        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <!-- Row 2: Toggle buttons + Amount input -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="3dp"
            android:layout_marginHorizontal="8dp"
            android:background="@drawable/bg_status_tab_selected"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/settleUnpaidBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/toggle_selected_background"
                android:fontFamily="@font/montserratalternatess_regular"
                android:paddingVertical="6dp"
                android:text="Unpaid"
                android:textColor="@color/whitest"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/settlePendingBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@android:color/transparent"
                android:fontFamily="@font/montserratalternatess_regular"
                android:paddingVertical="6dp"
                android:text="Pending"
                android:textColor="@color/grey"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/settlePaidBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:fontFamily="@font/montserratalternatess_regular"
                android:gravity="center"
                android:paddingVertical="6dp"
                android:text="Settled"
                android:textColor="@color/grey"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
