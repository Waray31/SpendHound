<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_add_expense_btn"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="12dp"
    android:paddingVertical="12dp">

    <ImageView
        android:id="@+id/settlePayorImage"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:scaleType="centerCrop"
        android:src="@drawable/placeholder_profile_image" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/settlePayorName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserratalternatess_bold"
                android:textColor="@color/darkBlue"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/settlePayorExcess"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="@font/montserratalternatess_bold"
                android:textColor="@color/green"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/settlePayorOwed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:fontFamily="@font/montserratalternatess_regular"
            android:textColor="@color/grey"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/settlePayorStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/toggle_selected_background"
        android:fontFamily="@font/montserratalternatess_bold"
        android:gravity="center"
        android:minWidth="72dp"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp"
        android:text="Unpaid"
        android:textColor="@color/whitest"
        android:textSize="11sp" />

</LinearLayout>
