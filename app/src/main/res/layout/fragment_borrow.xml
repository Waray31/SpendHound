<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".ui.borrow.BorrowFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingVertical="8dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/montserratalternatess_bold"
                android:text="@string/borrow_money_title"
                android:textAlignment="center"
                android:textColor="@color/darkBlue"
                android:textSize="22sp" />

        </LinearLayout>

        <View
            android:id="@+id/bottom_border1"
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bottom_border" />

        <!-- Main Card Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/darkBlue"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="4dp">

            <!-- Tab Section - Owe/Debt Toggle -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="8dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:padding="4dp">

                <TextView
                    android:id="@+id/owedTV"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/top_round_border"
                    android:fontFamily="@font/montserratalternatess_bold"
                    android:paddingVertical="14dp"
                    android:text="@string/owe_label"
                    android:textAlignment="center"
                    android:textColor="@color/darkBlue"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/debtTV"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="@font/montserratalternatess_bold"
                    android:paddingVertical="14dp"
                    android:text="@string/debt_label"
                    android:textAlignment="center"
                    android:textColor="@color/white"
                    android:background="@color/darkBlue"
                    android:textSize="15sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <!-- Content Area -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="8dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/bottom_round_border"
                android:elevation="2dp"
                android:orientation="vertical"
                android:paddingVertical="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginHorizontal="12dp"
                    android:orientation="vertical">

                    <!-- Filters Section -->
                    <LinearLayout
                        android:id="@+id/borrowFiltersLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="12dp"
                        android:gravity="center_vertical">

                        <!-- Month/Year Filter -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:orientation="vertical"
                            android:layout_marginEnd="8dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserratalternatess_bold"
                                android:text="@string/month_year_label"
                                android:textAlignment="center"
                                android:textSize="11sp"
                                android:textColor="@color/grey" />

                            <Spinner
                                android:id="@+id/monthYearSpinner"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textAlignment="center"
                                android:background="@drawable/transparent_background"
                                android:padding="8dp"/>

                        </LinearLayout>

                        <!-- Status Filter -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="2"
                            android:orientation="vertical"
                            android:layout_marginStart="8dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserratalternatess_bold"
                                android:text="@string/status_label"
                                android:textAlignment="center"
                                android:textSize="11sp"
                                android:textColor="@color/grey" />

                            <Spinner
                                android:id="@+id/statusSpinner"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:textAlignment="center"
                                android:background="@drawable/transparent_background"
                                android:padding="8dp" />

                        </LinearLayout>

                        <!-- Select All (shown during selection mode) -->
                        <LinearLayout
                            android:id="@+id/selectAllLayout"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:visibility="gone"
                            android:layout_marginStart="8dp"
                            android:gravity="center">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/montserratalternatess_bold"
                                android:text="@string/select_all_label"
                                android:textAlignment="center"
                                android:textSize="10sp"
                                android:textColor="@color/grey" />

                            <CheckBox
                                android:id="@+id/payAllCheckBox"
                                android:layout_width="24dp"
                                android:layout_gravity="center"
                                android:layout_marginTop="8dp"
                                android:layout_height="24dp"
                                android:buttonTint="@color/yellow"
                                android:contentDescription="@string/select_all_checkbox_description"/>

                        </LinearLayout>

                    </LinearLayout>

                    <View
                        android:id="@+id/bottom_border"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@drawable/border_line_darkblue" />

                    <!-- Loading Overlay -->
                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1">

                        <!-- Owed RecyclerView -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/owedRecyclerList"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="8dp"
                            android:clipToPadding="false"
                            android:paddingBottom="8dp"
                            tools:listitem="@layout/owed_row_layout" />

                        <!-- Debt RecyclerView -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/debtRecyclerList"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="8dp"
                            android:visibility="gone"
                            android:clipToPadding="false"
                            android:paddingBottom="8dp"
                            tools:listitem="@layout/debt_row_layout"/>

                        <!-- Debt Checkbox RecyclerView (selection mode) -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/debtCheckboxRecyclerList"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginTop="8dp"
                            android:visibility="gone"
                            android:clipToPadding="false"
                            android:paddingBottom="8dp"
                            tools:listitem="@layout/debt_rowcheckbox_layout"/>

                        <!-- Empty State for Debt -->
                        <LinearLayout
                            android:id="@+id/noDebtTextView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:visibility="gone"
                            android:padding="24dp">

                            <ImageView
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:src="@drawable/check"
                                android:alpha="0.5"
                                android:contentDescription="@string/empty_state_icon_description"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:fontFamily="@font/montserratalternatess_bold"
                                android:text="@string/no_debt_data_message"
                                android:textAlignment="center"
                                android:textSize="14sp"
                                android:textColor="@color/grey"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/montserratalternatess_regular"
                                android:text="@string/empty_debt_subtitle"
                                android:textAlignment="center"
                                android:textSize="12sp"
                                android:textColor="@color/lightgrey"/>

                        </LinearLayout>

                        <!-- Empty State for Owed -->
                        <LinearLayout
                            android:id="@+id/noOwedTextView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:visibility="gone"
                            android:padding="24dp">

                            <ImageView
                                android:layout_width="64dp"
                                android:layout_height="64dp"
                                android:src="@drawable/coin"
                                android:alpha="0.5"
                                android:contentDescription="@string/empty_state_icon_description"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="16dp"
                                android:fontFamily="@font/montserratalternatess_bold"
                                android:text="@string/no_owed_data_message"
                                android:textAlignment="center"
                                android:textSize="14sp"
                                android:textColor="@color/grey"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:fontFamily="@font/montserratalternatess_regular"
                                android:text="@string/empty_owed_subtitle"
                                android:textAlignment="center"
                                android:textSize="12sp"
                                android:textColor="@color/lightgrey"/>

                        </LinearLayout>

                        <!-- Loading Overlay -->
                        <LinearLayout
                            android:id="@+id/loadingOverlay"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@color/glassy_background"
                            android:gravity="center"
                            android:visibility="gone"
                            android:orientation="vertical">

                            <ProgressBar
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                style="@style/CustomProgressBarStyle"/>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/loading_text"
                                android:fontFamily="@font/montserratalternatess_regular"
                                android:textColor="@color/darkBlue"
                                android:textSize="14sp"/>

                        </LinearLayout>

                    </FrameLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Decorative zigzag -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:elevation="4dp"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_weight="1"
                android:background="@drawable/zigzag_lines"
                android:elevation="4dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_weight="1"
                android:background="@drawable/zigzag_lines"
                android:elevation="4dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_weight="1"
                android:background="@drawable/zigzag_lines"
                android:elevation="4dp" />

            <View
                android:layout_width="0dp"
                android:layout_height="20dp"
                android:layout_weight="1"
                android:background="@drawable/zigzag_lines"
                android:elevation="4dp" />

        </LinearLayout>

        <!-- Debt Action Buttons -->
        <LinearLayout
            android:id="@+id/debtButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <Button
                android:id="@+id/borrowNowBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/yellow"
                android:elevation="6dp"
                android:fontFamily="@font/montserratalternatess_bold"
                android:paddingVertical="14dp"
                android:text="@string/borrow_now_button"
                android:textColor="@color/darkBlue"
                android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button" />

            <Button
                android:id="@+id/payNowBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/red"
                android:elevation="6dp"
                android:fontFamily="@font/montserratalternatess_bold"
                android:paddingVertical="14dp"
                android:text="@string/pay_now_button"
                android:textColor="@color/whitest"
                android:textSize="12sp"
                style="@style/Widget.MaterialComponents.Button" />

            <Button
                android:id="@+id/debtCancelPayBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/grey"
                android:elevation="6dp"
                android:fontFamily="@font/montserratalternatess_bold"
                android:paddingVertical="14dp"
                android:text="@string/cancel_button"
                android:textColor="@color/whitest"
                android:textSize="12sp"
                android:visibility="gone"
                style="@style/Widget.MaterialComponents.Button" />

            <Button
                android:id="@+id/debtSelectBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="@color/green"
                android:elevation="6dp"
                android:fontFamily="@font/montserratalternatess_bold"
                android:paddingVertical="14dp"
                android:text="@string/select_button"
                android:textColor="@color/whitest"
                android:textSize="12sp"
                android:visibility="gone"
                style="@style/Widget.MaterialComponents.Button" />

        </LinearLayout>

        <!-- Pending Status Button (for Owed tab) -->
        <Button
            android:id="@+id/pendingStatusBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:backgroundTint="@color/yellow"
            android:elevation="6dp"
            android:fontFamily="@font/montserratalternatess_bold"
            android:paddingVertical="14dp"
            android:text="@string/pending_status_button"
            android:textColor="@color/darkBlue"
            android:textSize="13sp"
            android:drawableStart="@drawable/waiting"
            android:drawablePadding="8dp"
            style="@style/Widget.MaterialComponents.Button" />

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>