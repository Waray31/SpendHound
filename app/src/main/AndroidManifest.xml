<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />


    <application
        android:name=".SpendHoundApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SpendHound"
        tools:targetApi="tiramisu"
        android:enableOnBackInvokedCallback="true">

        <!-- Google Sign-In -->
        <activity
            android:name="com.google.android.gms.auth.api.signin.internal.SignInHubActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <activity
            android:name="com.google.android.gms.common.api.GoogleApiActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />


        <activity
            android:name=".MainActivity"
            android:exported="true"/>

        <activity android:name=".ui.multi_transaction.MultiTransactionActivity"
            android:exported="true"
            android:label="Add Expenses"
            android:theme="@style/Theme.SpendHound.NoActionBar"
            android:windowSoftInputMode="adjustPan"/>

        <activity android:name=".ui.multi_transaction.ExpenseHistoryActivity"
            android:exported="false"
            android:label="Expense History"
            android:theme="@style/Theme.SpendHound.NoActionBar"
            android:parentActivityName=".ui.multi_transaction.MultiTransactionActivity" />

        <activity android:name=".BorrowNowActivity"
            android:exported="true"
            android:label="Borrow Money"
            android:theme="@style/Theme.SpendHound.NoActionBar"
            android:windowSoftInputMode="adjustPan"/>

        <activity android:name=".GroupsActivity"
            android:exported="false"
            android:label="My Groups"
            android:theme="@style/Theme.SpendHound.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".MainActivity" />

        <activity android:name=".CreateGroupActivity"
            android:exported="false"
            android:label="New Group"
            android:theme="@style/Theme.SpendHound.NoActionBar"
            android:windowSoftInputMode="adjustPan"
            android:parentActivityName=".GroupsActivity" />

        <activity android:name=".EditGroupActivity"
            android:exported="false"
            android:label="Edit Group"
            android:theme="@style/Theme.SpendHound.NoActionBar"
            android:windowSoftInputMode="adjustPan"
            android:parentActivityName=".GroupsActivity" />

        <activity android:name=".GroupDetailActivity"
            android:exported="false"
            android:label="Group"
            android:theme="@style/Theme.SpendHound.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".GroupsActivity" />

        <activity android:name=".TransactionDetailActivity"
            android:exported="false"
            android:label="Transaction Detail"
            android:theme="@style/Theme.SpendHound.NoActionBar"
            android:parentActivityName=".GroupDetailActivity" />

        <activity android:name=".LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"/>

        <activity android:name=".EditProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".ChangePasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".PasskeySetupActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar" />

        <activity android:name=".SignUpActivity"
            android:exported="true"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar"/>

        <activity android:name=".PendingStatusActivity"
            android:exported="true"
            android:theme="@style/Theme.MaterialComponents.Light.NoActionBar" />

        <activity android:name=".CrewMembersActivity"
            android:exported="false"
            android:label="My Crew"
            android:theme="@style/Theme.SpendHound.NoActionBar"
            android:parentActivityName=".MainActivity" />

        <activity android:name=".AddCrewActivity"
            android:exported="false"
            android:label="Add Crew"
            android:theme="@style/Theme.SpendHound.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".MainActivity" />

        <activity android:name=".DirectMessageActivity"
            android:exported="false"
            android:label="Direct Message"
            android:theme="@style/Theme.SpendHound.NoActionBar"
            android:windowSoftInputMode="adjustResize" />

        <activity android:name=".SettlementActivity"
            android:exported="false"
            android:label="Settle Up"
            android:theme="@style/Theme.SpendHound.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".GroupDetailActivity" />

        <activity android:name=".SettlementHistoryActivity"
            android:exported="false"
            android:label="Settlement History"
            android:theme="@style/Theme.SpendHound.NoActionBar"
            android:parentActivityName=".SettlementActivity" />

        <activity android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.SpendHound.NoActionBar" />

        <activity android:name=".TransactionSettlementActivity"
            android:exported="false"
            android:theme="@style/Theme.SpendHound.NoActionBar"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".MainActivity" />

        <activity android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.App.SplashScreen">

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>

                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.waray.spendhound.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
